<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DualSenseClient.GUI.Controls.Cards">
    <!-- ToggleSwitchCard: Labeled card with a ToggleSwitch on the right.
         Binds IsChecked two-way and supports an optional Command. -->
    <Style Selector="local|ToggleSwitchCard">
        <Setter Property="Template">
            <ControlTemplate TargetType="local:ToggleSwitchCard">
                <local:CustomCard Tooltip="{TemplateBinding Tooltip}">
                    <Grid ColumnDefinitions="*,Auto">
                        <local:CardHeader Grid.Column="0"
                                          Title="{TemplateBinding Title}"
                                          Description="{TemplateBinding Description}"
                                          Icon="{TemplateBinding Icon}"
                                          ShowIconBackground="{TemplateBinding ShowIconBackground}" />
                        <ToggleSwitch Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsChecked,RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Command="{TemplateBinding Command}" />
                    </Grid>
                </local:CustomCard>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>