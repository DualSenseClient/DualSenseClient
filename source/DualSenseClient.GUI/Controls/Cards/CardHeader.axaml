<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DualSenseClient.GUI.Controls.Cards"
        xmlns:fluent="using:FluentIcons.Avalonia.Fluent">
    <!-- CardHeader: Icon, title, description, and optional action area.
         Icon uses AccentFillColorDefaultBrush; description uses TextFillColorSecondaryBrush.
         When ShowIconBackground=false, the icon border background becomes transparent.
         Requires NotNullConverter to hide empty icons/descriptions. -->
    <Style Selector="local|CardHeader">
        <Setter Property="Template">
            <ControlTemplate TargetType="local:CardHeader">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ToolTip.Tip="{TemplateBinding Tooltip}">
                    <Border x:Name="IconBorder"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            Padding="6"
                            CornerRadius="6"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center"
                            IsVisible="{TemplateBinding Icon, Converter={StaticResource NotNullConverter}}">
                        <fluent:SymbolIcon Symbol="{TemplateBinding Icon}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{TemplateBinding Title}" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{TemplateBinding Description}"
                                   IsVisible="{TemplateBinding Description, Converter={StaticResource NotNullConverter}}" />
                    </StackPanel>

                    <ContentPresenter Grid.Column="2"
                                      Content="{TemplateBinding ActionContent}"
                                      ContentTemplate="{TemplateBinding ActionContentTemplate}"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="local|CardHeader[ShowIconBackground=false] Border#IconBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</Styles>