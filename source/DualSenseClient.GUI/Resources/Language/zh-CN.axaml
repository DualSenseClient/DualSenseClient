<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Add UI Strings Here -->
    <sys:String x:Key="MainWindow.Title">DualSense 客户端</sys:String>
    <sys:String x:Key="MainWindow.Settings">设置</sys:String>

    <!-- Title Bar -->
    <sys:String x:Key="MainWindow.ScanDevices.Start">扫描控制器</sys:String>
    <sys:String x:Key="MainWindow.ScanDevices.Stop">停止扫描</sys:String>
    <sys:String x:Key="MainWindow.DisconnectController">断开控制器</sys:String>
    <sys:String x:Key="MainWindow.DisconnectController.Failed">{0} 无法断开连接</sys:String>

    <!-- Tray Icon -->
    <sys:String x:Key="Tray.Show">显示</sys:String>
    <sys:String x:Key="Tray.Exit">退出</sys:String>
    <sys:String x:Key="Tray.Select">选择</sys:String>
    <sys:String x:Key="Tray.Profiles">配置文件</sys:String>
    <sys:String x:Key="Tray.Emulation">虚拟控制器</sys:String>
    <sys:String x:Key="Tray.Disconnect">断开连接</sys:String>
    <sys:String x:Key="Tray.NoControllers">未连接控制器</sys:String>

    <!-- Notification Popups -->
    <sys:String x:Key="Notification.Connected.Title">控制器已连接</sys:String>
    <sys:String x:Key="Notification.Connected.Message">{0} 已通过 {1} 连接</sys:String>
    <sys:String x:Key="Notification.Disconnected.Title">控制器已断开</sys:String>
    <sys:String x:Key="Notification.Disconnected.Message">{0} 已断开</sys:String>
    <sys:String x:Key="Notification.LowBattery.Title">电量低</sys:String>
    <sys:String x:Key="Notification.LowBattery.Message">{0} 电量低（{1}%）</sys:String>
    <sys:String x:Key="Notification.Charged.Title">控制器已充满</sys:String>
    <sys:String x:Key="Notification.Charged.Message">{0} 已充至 {1}%</sys:String>
    <sys:String x:Key="Notification.Test.Title">测试通知</sys:String>
    <sys:String x:Key="Notification.Test.Message">这是通知的样式。</sys:String>
    <sys:String x:Key="Notification.Update.Title">有可用更新</sys:String>
    <sys:String x:Key="Notification.Update.Message">版本 {0} 已可用。点击打开发布页面。</sys:String>
    <sys:String x:Key="Notification.Update.Failed.Title">更新失败</sys:String>
    <sys:String x:Key="Notification.Update.Failed.Message">更新无法安装。点击打开发布页面。</sys:String>
    <sys:String x:Key="Notification.Update.Restart.Title">重启以更新</sys:String>
    <sys:String x:Key="Notification.Update.Restart.Message">版本 {0} 已下载。应用将重启以应用更新。</sys:String>
    <sys:String x:Key="Notification.Update.Downloading.Title">正在下载更新</sys:String>
    <sys:String x:Key="Notification.Update.Downloading.Message">正在下载版本 {0}… {1:F0}%</sys:String>
    <sys:String x:Key="Notification.Changelog.Title">更新内容</sys:String>
    <sys:String x:Key="Notification.Battery.Title">电量</sys:String>
    <sys:String x:Key="Notification.Battery.Message">{0}：{1}%</sys:String>
    <sys:String x:Key="Notification.AutoProfile.Title">自动配置已切换</sys:String>
    <sys:String x:Key="Notification.AutoProfile.Message">{0} 现在使用 {1}</sys:String>

    <!-- Splash Screen -->
    <sys:String x:Key="SplashScreen.LoadingProfiles">正在加载配置文件…</sys:String>
    <sys:String x:Key="SplashScreen.StartingServices">正在启动服务…</sys:String>
    <sys:String x:Key="SplashScreen.ScanningControllers">正在扫描控制器…</sys:String>
    <sys:String x:Key="SplashScreen.CheckingUpdates">正在检查更新…</sys:String>

    <!-- Device Info Page -->
    <sys:String x:Key="MainWindow.Devices">设备信息</sys:String>
    <sys:String x:Key="DeviceInfoPage.NoDevice.Title">未选择控制器</sys:String>
    <sys:String x:Key="DeviceInfoPage.NoDevice.Description">从标题栏选择一个控制器以查看其固件和硬件信息。</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Title">设备</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Description">控制器标识</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Name">名称</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Skin">外观</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Skin.Description">上方显示的控制器示意图。按控制器存储。</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.ConnectionType">连接方式</sys:String>
    <sys:String x:Key="DeviceInfoPage.Pairing.ClientMac">控制器 MAC</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Title">固件</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Description">版本与构建信息</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Refresh">重新读取固件信息</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.MainVersion">主固件</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.SblVersion">SBL 固件</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.DspVersion">DSP 固件</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.McuDspVersion">MCU/Spider DSP</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.ModelRevision">型号修订</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.HardwareVersion">硬件版本</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.HardwareGeneration">硬件代次</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.BuildDate">构建日期</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.BuildTime">构建时间</sys:String>

    <!-- Device Info Page: Battery -->
    <sys:String x:Key="DeviceInfoPage.Battery.Level">电量</sys:String>
    <sys:String x:Key="DeviceInfoPage.Battery.PowerState">电源状态</sys:String>

    <!-- Device Info Page: Connection Status -->
    <sys:String x:Key="DeviceInfoPage.Connection.Title">连接状态</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Description">音频与 USB 连接状态</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Headphones">耳机</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Microphone">麦克风</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.MicrophoneMuted">麦克风已静音</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.UsbData">USB 数据</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.UsbPower">USB 供电</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Yes">是</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.No">否</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Connected">已连接</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.NotConnected">未连接</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Active">活动</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Inactive">未活动</sys:String>

    <!-- MessageBox Strings -->
    <sys:String x:Key="MessageBox.Ok">确定</sys:String>
    <sys:String x:Key="MessageBox.Yes">是</sys:String>
    <sys:String x:Key="MessageBox.No">否</sys:String>
    <sys:String x:Key="MessageBox.Cancel">取消</sys:String>

    <!-- Input Monitor Page -->
    <sys:String x:Key="MainWindow.InputMonitor">输入监视器</sys:String>
    <sys:String x:Key="MainWindow.Profile">配置文件</sys:String>
    <sys:String x:Key="MainWindow.AutoProfiles">自动配置文件</sys:String>
    <sys:String x:Key="MainWindow.VirtualController">虚拟控制器</sys:String>
    <sys:String x:Key="InputMonitorPage.NoDevice.Title">未选择控制器</sys:String>
    <sys:String x:Key="InputMonitorPage.NoDevice.Description">从标题栏选择一个控制器以监视其实时输入状态。</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.Live">实时</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.Waiting">等待报告</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.PollingRate">轮询率：</sys:String>
    <sys:String x:Key="InputMonitorPage.Controller.Title">控制器</sys:String>
    <sys:String x:Key="InputMonitorPage.Controller.Description">按键、摇杆、扳机和触摸板</sys:String>
    <sys:String x:Key="InputMonitorPage.Display.Lights.Title">灯</sys:String>
    <sys:String x:Key="InputMonitorPage.Display.Stats.Title">统计</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroX">陀螺仪 X</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroY">陀螺仪 Y</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroZ">陀螺仪 Z</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelX">加速度 X</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelY">加速度 Y</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelZ">加速度 Z</sys:String>
    <sys:String x:Key="InputMonitorPage.Common.Active">活动</sys:String>
    <sys:String x:Key="InputMonitorPage.Common.Inactive">未活动</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.FnL">左功能键</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.FnR">右功能键</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.L4">左背键</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.R4">右背键</sys:String>

    <!-- Input Monitor Page: Output Test -->
    <sys:String x:Key="InputMonitorPage.OutputTest.Title">输出测试</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Description">振动与自适应扳机测试</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Title">振动</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Left">左马达</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Right">右马达</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Enable">震动</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Strength">强度</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Title">自适应扳机</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Left">L2</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Right">R2</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode">效果模式</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Off">关闭</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Resistance">阻力</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Trigger">扳机（武器）</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Automatic">自动（振动）</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Start">起始位置</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.End">结束位置</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Force">力度</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Frequency">频率</sys:String>

    <!-- Input Monitor Page: Audio Player -->
    <sys:String x:Key="InputMonitorPage.Audio.Title">音频播放器</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Description">将音频播放到你的电脑、DualSense 扬声器、耳机或触觉</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.File">文件</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Open">打开</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.PickTitle">打开音频文件</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.FileType">音频文件</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Title">输出目标</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Desktop">桌面扬声器</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.DualSense">DualSense 输出</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.DualSense.Description">控制器播放流的位置。扬声器与耳机不能同时使用。</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.None">关闭</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Speaker">扬声器</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Headset">耳机</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Haptics">触觉反馈</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.OutputVolume">输出音量</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.HapticStrength">触觉强度</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.NoFile">未加载文件</sys:String>

    <!-- Profile Page -->
    <sys:String x:Key="ProfilePage.NoDevice.Title">未选择控制器</sys:String>
    <sys:String x:Key="ProfilePage.NoDevice.Description">从标题栏选择一个 DualSense 控制器以自定义其配置文件。</sys:String>
    <sys:String x:Key="ProfilePage.Controller.Title">控制器</sys:String>
    <sys:String x:Key="ProfilePage.Controller.Description">所选控制器的配置文件分配</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Title">已分配配置文件</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Description">此控制器连接时自动应用</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Reapply">重新应用配置文件</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Title">配置文件</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Description">创建、编辑和管理已保存的灯光配置文件</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.New">创建新配置文件</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Duplicate">复制所选配置文件</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Delete">删除所选配置文件</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Empty">暂无配置文件。点击添加按钮创建一个。</sys:String>
    <sys:String x:Key="ProfilePage.Name.Title">名称</sys:String>
    <sys:String x:Key="ProfilePage.Delete.Title">删除配置文件</sys:String>
    <sys:String x:Key="ProfilePage.Delete.Message">删除配置文件“{name}”？分配给它的控制器将回退到默认配置文件。</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Title">光条</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Red">红</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Green">绿</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Blue">蓝</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Title">麦克风 LED</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode">模式</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.Off">关闭</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.On">开启</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.Pulse">呼吸</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Title">玩家 LED</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player1">玩家 1</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player2">玩家 2</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player3">玩家 3</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player4">玩家 4</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player5">玩家 5</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led1">LED 1</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led2">LED 2</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led3">LED 3</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led4">LED 4</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led5">LED 5</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Title">虚拟控制器</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode">虚拟控制器</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.Description">创建一个虚拟控制器，将本控制器的输入镜像到主机。反馈（震动、光条、扳机）会回传。这些设置按控制器存储。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.Off">关闭</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.Xbox360">Xbox 360</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.DualShock4">DualShock 4</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.DualSense">DualSense</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType">DualSense 类型</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType.Description">虚拟控制器的硬件呈现方式。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType.Standard">标准</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType.Edge">Edge</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant">DualShock 4 型号</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant.Description">虚拟控制器的硬件世代。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant.V1">V1 (CUH-ZCT1)</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant.V2">V2 (CUH-ZCT2)</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput">转发音频输出</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput.Description">主机音频在物理控制器上的播放位置。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput.Speaker">扬声器</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput.Headset">耳机</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardVolume">音频音量</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardVolume.Description">转发到控制器的桌面声音音量。仅在虚拟音频输出被选为默认播放设备时生效。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardHaptics">触觉强度</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardHaptics.Description">从转发的桌面声音产生的振动强度。仅在虚拟音频输出被选为默认播放设备时生效。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForceAudioHaptics">基于音频的触觉</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForceAudioHaptics.Description">从转发的音频派生振动，而不是游戏自身的触觉。触觉强度滑块始终适用于基于音频的触觉。仅适用于通过蓝牙的 DualSense 模拟。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.Idle">未激活虚拟控制器。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.Running">虚拟控制器已激活：{mode}</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.RunningEdge">虚拟控制器已激活：DualSense Edge</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.Creating">正在创建虚拟控制器…</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Title">按键映射</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Description">在虚拟控制器上重新映射本控制器的物理按键。点击示意图上的按键选择一个或多个源，选择一个或多个目标（它们一起按下），然后分配。</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Clear">清除选择</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Output">扳机输出</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Output.Full">全拉（模拟）</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Output.Click">仅点击标志</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.SuppressSolos">组合按住时静音成员按键自身的输出</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Assign">分配映射</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Reset">重置为默认</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Target.None">无（禁用）</sys:String>
    <sys:String x:Key="VirtualControllerPage.Binding.Remove">移除此绑定</sys:String>
    <sys:String x:Key="VirtualControllerPage.Binding.OutputClick">仅点击</sys:String>
    <sys:String x:Key="VirtualControllerPage.Binding.SolosKept">保留独奏</sys:String>
    <sys:String x:Key="DeviceInfoPage.Hiding.Title">隐藏此控制器</sys:String>
    <sys:String x:Key="DeviceInfoPage.Hiding.HideController.Description">阻止其他应用程序看到此物理控制器。</sys:String>
    <sys:String x:Key="DeviceInfoPage.Hiding.Description.NotInstalled">未安装 HidHide 驱动。请安装它以隐藏控制器。</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Title">特殊动作</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Description">执行动作（断开连接、灯光）的按键组合</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.New">创建新的特殊动作</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Empty">暂无特殊动作。点击添加按钮创建一个。</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.ToolTip">从文件导入特殊动作</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Picker">选择特殊动作文件</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.FileType">特殊动作文件</sys:String>
