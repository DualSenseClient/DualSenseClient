    <sys:String x:Key="AutoProfilesPage.RuleTitle.Description">聚焦窗口的标题，或为空匹配任意标题</sys:String>
    <sys:String x:Key="AutoProfilesPage.Scope.Title">匹配方式</sys:String>
    <sys:String x:Key="AutoProfilesPage.Scope.Description">哪些过滤器必须匹配聚焦程序</sys:String>
