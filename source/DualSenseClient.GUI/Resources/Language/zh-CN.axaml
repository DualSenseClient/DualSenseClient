    <sys:String x:Key="AutoProfilesPage.Unsupported.Title">此平台不支持</sys:String>
    <sys:String x:Key="AutoProfilesPage.Unsupported.Description">前台应用切换需要 Windows 焦点跟踪。</sys:String>
    <sys:String x:Key="AutoProfilesPage.General.Title">自动切换</sys:String>
    <sys:String x:Key="AutoProfilesPage.General.Description">根据聚焦的程序应用配置文件与模拟模式</sys:String>
    <sys:String x:Key="AutoProfilesPage.Enabled.Title">启用自动配置文件</sys:String>
    <sys:String x:Key="AutoProfilesPage.Enabled.Description">规则匹配时临时切换配置文件与虚拟控制器</sys:String>
    <sys:String x:Key="AutoProfilesPage.Rules.Title">规则</sys:String>
