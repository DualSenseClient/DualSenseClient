    <!-- Auto Profiles Page -->
    <sys:String x:Key="AutoProfilesPage.Unsupported.Title">Not supported on this platform</sys:String>
    <sys:String x:Key="AutoProfilesPage.Unsupported.Description">Foreground-app switching needs Windows focus tracking.</sys:String>
    <sys:String x:Key="AutoProfilesPage.General.Title">Automatic switching</sys:String>
