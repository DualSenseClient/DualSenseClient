    <sys:String x:Key="CustomizationPage.SpecialActions.Button.L2">L2</sys:String>
    <sys:String x:Key="CustomizationPage.SpecialActions.Button.L3">L3</sys:String>
    <sys:String x:Key="CustomizationPage.SpecialActions.Button.Mute">Mute</sys:String>
