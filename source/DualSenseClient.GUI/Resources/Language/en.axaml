    <sys:String x:Key="DeviceInfoPage.Monitor.Touchpad.Touch2">Touch 2</sys:String>
    <!-- NoDevice -->
    <sys:String x:Key="DeviceInfoPage.NoDevice.Description">Select a controller from the title bar to view its information</sys:String>
    <sys:String x:Key="DeviceInfoPage.NoDevice.Title">No controller selected</sys:String>
    <!-- Pairing -->
    <sys:String x:Key="DeviceInfoPage.Pairing.ClientMac">Controller MAC</sys:String>

