    <sys:String x:Key="ProfilePage.SpecialActions.Effects.Battery">Battery level</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery">Battery level</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Description">Shows the current charge in 10 levels on the lightbar and/or in a notification popup; pick a color per level. Can be combined with a lightbar color, which takes over the lightbar. Not available with player LEDs.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Level">Charge level</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Level.Description">The level whose color the picker edits</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Notify">Show notification</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Notify.Description">Also show the battery level in a desktop notification popup. Stays open while the combination is held when Apply while held is set.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Lightbar">Show on lightbar</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Lightbar.Description">Show the charge level colors on the controller lightbar.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Battery.Reset">Reset colors</sys:String>
