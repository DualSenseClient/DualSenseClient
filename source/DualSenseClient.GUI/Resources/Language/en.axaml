<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Add UI Strings Here -->
    <sys:String x:Key="MainWindow.Title">DualSense Client</sys:String>
    <sys:String x:Key="MainWindow.Settings">Settings</sys:String>

    <!-- Title Bar -->
    <sys:String x:Key="MainWindow.ScanDevices.Start">Scan for controllers</sys:String>
    <sys:String x:Key="MainWindow.ScanDevices.Stop">Stop scanning</sys:String>
    <sys:String x:Key="MainWindow.DisconnectController">Disconnect controller</sys:String>
    <sys:String x:Key="MainWindow.DisconnectController.Failed">{0} could not be disconnected</sys:String>

    <!-- Tray Icon -->
    <sys:String x:Key="Tray.Show">Show</sys:String>
    <sys:String x:Key="Tray.Exit">Exit</sys:String>
    <sys:String x:Key="Tray.Select">Select</sys:String>
    <sys:String x:Key="Tray.Profiles">Profiles</sys:String>
    <sys:String x:Key="Tray.Emulation">Virtual controller</sys:String>
    <sys:String x:Key="Tray.Disconnect">Disconnect</sys:String>
    <sys:String x:Key="Tray.NoControllers">No controllers connected</sys:String>

    <!-- Notification Popups -->
    <sys:String x:Key="Notification.Connected.Title">Controller connected</sys:String>
    <sys:String x:Key="Notification.Connected.Message">{0} connected via {1}</sys:String>
    <sys:String x:Key="Notification.Disconnected.Title">Controller disconnected</sys:String>
    <sys:String x:Key="Notification.Disconnected.Message">{0} disconnected</sys:String>
    <sys:String x:Key="Notification.LowBattery.Title">Low battery</sys:String>
    <sys:String x:Key="Notification.LowBattery.Message">{0} battery is low ({1}%)</sys:String>
    <sys:String x:Key="Notification.Charged.Title">Controller charged</sys:String>
    <sys:String x:Key="Notification.Charged.Message">{0} charged to {1}%</sys:String>
    <sys:String x:Key="Notification.Test.Title">Test notification</sys:String>
    <sys:String x:Key="Notification.Test.Message">This is what notifications look like.</sys:String>
    <sys:String x:Key="Notification.Update.Title">Update available</sys:String>
    <sys:String x:Key="Notification.Update.Message">Version {0} is available. Click to open the release page.</sys:String>
    <sys:String x:Key="Notification.Update.Failed.Title">Update failed</sys:String>
    <sys:String x:Key="Notification.Update.Failed.Message">The update could not be installed. Click to open the release page.</sys:String>
    <sys:String x:Key="Notification.Update.Restart.Title">Restart to update</sys:String>
    <sys:String x:Key="Notification.Update.Restart.Message">Version {0} is downloaded. The app will now restart to apply the update.</sys:String>
    <sys:String x:Key="Notification.Changelog.Title">What's new</sys:String>
    <sys:String x:Key="Notification.Battery.Title">Battery level</sys:String>
    <sys:String x:Key="Notification.Battery.Message">{0}: {1}%</sys:String>
    <sys:String x:Key="Notification.AutoProfile.Title">Auto profile switched</sys:String>
    <sys:String x:Key="Notification.AutoProfile.Message">{0} is now using {1}</sys:String>

    <!-- Splash Screen -->
    <sys:String x:Key="SplashScreen.LoadingProfiles">Loading profiles...</sys:String>
    <sys:String x:Key="SplashScreen.StartingServices">Starting services...</sys:String>
    <sys:String x:Key="SplashScreen.ScanningControllers">Scanning for controllers...</sys:String>
    <sys:String x:Key="SplashScreen.CheckingUpdates">Checking for updates...</sys:String>

    <!-- Device Info Page -->
    <sys:String x:Key="MainWindow.Devices">Device Info</sys:String>
    <sys:String x:Key="DeviceInfoPage.NoDevice.Title">No controller selected</sys:String>
    <sys:String x:Key="DeviceInfoPage.NoDevice.Description">Select a controller from the title bar to view its firmware and hardware information.</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Title">Device</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Description">Controller identification</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Name">Name</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Skin">Skin</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Skin.Description">The controller illustration shown above. Stored per controller.</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.ConnectionType">Connection</sys:String>
    <sys:String x:Key="DeviceInfoPage.Pairing.ClientMac">Controller MAC</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Title">Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Description">Version and build information</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Refresh">Re-read firmware info</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.MainVersion">Main Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.SblVersion">SBL Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.DspVersion">DSP Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.McuDspVersion">MCU/Spider DSP</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.ModelRevision">Model Revision</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.HardwareVersion">Hardware Version</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.HardwareGeneration">Hardware Generation</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.BuildDate">Build Date</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.BuildTime">Build Time</sys:String>

    <!-- Device Info Page: Battery -->
    <sys:String x:Key="DeviceInfoPage.Battery.Level">Battery Level</sys:String>
    <sys:String x:Key="DeviceInfoPage.Battery.PowerState">Power State</sys:String>

    <!-- Device Info Page: Connection Status -->
    <sys:String x:Key="DeviceInfoPage.Connection.Title">Connection Status</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Description">Audio and USB connection state</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Headphones">Headphones</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Microphone">Microphone</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.MicrophoneMuted">Microphone Muted</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.UsbData">USB Data</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.UsbPower">USB Power</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Yes">Yes</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.No">No</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Connected">Connected</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.NotConnected">Not connected</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Active">Active</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Inactive">Inactive</sys:String>

    <!-- MessageBox Strings -->
    <sys:String x:Key="MessageBox.Ok">OK</sys:String>
    <sys:String x:Key="MessageBox.Yes">Yes</sys:String>
    <sys:String x:Key="MessageBox.No">No</sys:String>
    <sys:String x:Key="MessageBox.Cancel">Cancel</sys:String>

    <!-- Input Monitor Page -->
    <sys:String x:Key="MainWindow.InputMonitor">Input Monitor</sys:String>
    <sys:String x:Key="MainWindow.Profile">Profile</sys:String>
    <sys:String x:Key="MainWindow.AutoProfiles">Auto Profiles</sys:String>
    <sys:String x:Key="MainWindow.VirtualController">Virtual Controller</sys:String>
    <sys:String x:Key="InputMonitorPage.NoDevice.Title">No controller selected</sys:String>
    <sys:String x:Key="InputMonitorPage.NoDevice.Description">Select a controller from the title bar to monitor its live input state.</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.Live">Live</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.Waiting">Waiting for reports</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.PollingRate">Polling rate:</sys:String>
    <sys:String x:Key="InputMonitorPage.Controller.Title">Controller</sys:String>
    <sys:String x:Key="InputMonitorPage.Controller.Description">Buttons, sticks, triggers, and touchpad</sys:String>
    <sys:String x:Key="InputMonitorPage.Display.Lights.Title">Lights</sys:String>
    <sys:String x:Key="InputMonitorPage.Display.Stats.Title">Stats</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroX">Gyro X</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroY">Gyro Y</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroZ">Gyro Z</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelX">Accel X</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelY">Accel Y</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelZ">Accel Z</sys:String>
    <sys:String x:Key="InputMonitorPage.Common.Active">Active</sys:String>
    <sys:String x:Key="InputMonitorPage.Common.Inactive">Inactive</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.FnL">FnL</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.FnR">FnR</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.L4">L4</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.R4">R4</sys:String>

    <!-- Input Monitor Page: Output Test -->
    <sys:String x:Key="InputMonitorPage.OutputTest.Title">Output Test</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Description">Vibration and adaptive trigger testing</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Title">Vibration</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Left">Left Motor</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Right">Right Motor</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Enable">Rumble</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Strength">Strength</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Title">Adaptive Triggers</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Left">L2</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Right">R2</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode">Effect mode</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Off">Off</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Resistance">Resistance</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Trigger">Trigger (weapon)</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Automatic">Automatic (vibration)</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Start">Start position</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.End">End position</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Force">Force</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Frequency">Frequency</sys:String>

    <!-- Input Monitor Page: Audio Player -->
    <sys:String x:Key="InputMonitorPage.Audio.Title">Audio Player</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Description">Play audio to your PC, the DualSense speaker, headset, or haptics</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.File">File</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Open">Open</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.PickTitle">Open audio file</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.FileType">Audio files</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Title">Output Destinations</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Desktop">Desktop Speakers</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.DualSense">DualSense Output</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.DualSense.Description">Where the controller plays the stream. The speaker and headset cannot run at the same time.</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.None">Off</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Speaker">Speaker</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Headset">Headset</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.Output.Haptics">Haptic Feedback</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.OutputVolume">Output Volume</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.HapticStrength">Haptic Strength</sys:String>
    <sys:String x:Key="InputMonitorPage.Audio.NoFile">No file loaded</sys:String>

    <!-- Profile Page -->
    <sys:String x:Key="ProfilePage.NoDevice.Title">No controller selected</sys:String>
    <sys:String x:Key="ProfilePage.NoDevice.Description">Select a DualSense controller from the title bar to customize its profile.</sys:String>
    <sys:String x:Key="ProfilePage.Controller.Title">Controller</sys:String>
    <sys:String x:Key="ProfilePage.Controller.Description">Profile assignment for the selected controller</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Title">Assigned profile</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Description">Applied automatically when this controller connects</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Reapply">Re-apply profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Title">Profiles</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Description">Create, edit, and manage saved light profiles</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.New">Create a new profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Duplicate">Duplicate the selected profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Delete">Delete the selected profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Empty">No profiles yet. Use the add button to create one.</sys:String>
    <sys:String x:Key="ProfilePage.Name.Title">Name</sys:String>
    <sys:String x:Key="ProfilePage.Delete.Title">Delete profile</sys:String>
    <sys:String x:Key="ProfilePage.Delete.Message">Delete profile "{name}"? Controllers assigned to it will fall back to the default profile.</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Title">Lightbar</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Red">Red</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Green">Green</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Blue">Blue</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Title">Microphone LED</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode">Mode</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.Off">Off</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.On">On</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.Pulse">Pulse</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Title">Player LEDs</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player1">Player 1</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player2">Player 2</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player3">Player 3</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player4">Player 4</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Player5">Player 5</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led1">LED 1</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led2">LED 2</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led3">LED 3</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led4">LED 4</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led5">LED 5</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Title">Virtual Controller</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode">Virtual Controller</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.Description">Creates a virtual controller that mirrors this controller's input to the host. Feedback (rumble, lightbar, triggers) is forwarded back. These settings are stored per controller.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.Off">Off</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.Xbox360">Xbox 360</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.DualShock4">DualShock 4</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Mode.DualSense">DualSense</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType">DualSense Variant</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType.Description">The hardware presentation of the virtual controller.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType.Standard">Standard</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.DeviceType.Edge">Edge</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant">DualShock 4 Variant</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant.Description">The hardware generation of the virtual controller.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant.V1">V1 (CUH-ZCT1)</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Ds4Variant.V2">V2 (CUH-ZCT2)</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput">Forwarded Audio Output</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput.Description">Where host audio is played back on the physical controller.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput.Speaker">Speaker</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.AudioOutput.Headset">Headset</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardVolume">Audio Volume</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardVolume.Description">Volume of the desktop sounds forwarded to the controller. Only applies while the virtual audio output is selected as the default playback device.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardHaptics">Haptic Strength</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.ForwardHaptics.Description">Strength of the vibration generated from forwarded desktop sounds. Only applies while the virtual audio output is selected as the default playback device.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.Idle">No virtual controller is active.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.Running">Virtual controller active: {mode}</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.RunningEdge">Virtual controller active: DualSense Edge</sys:String>
    <sys:String x:Key="VirtualControllerPage.Emulation.Status.Creating">Creating virtual controller…</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Title">Button Mapping</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Description">Remap the physical buttons of this controller on the virtual controller. Click buttons on the illustration to select one or more sources, pick one or more targets (they are pressed together), then assign.</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Clear">Clear the selection</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Output">Trigger output</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Output.Full">Full pull (analog)</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Output.Click">Click flag only</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.SuppressSolos">Mute member buttons' own outputs while the combo is held</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Assign">Assign mapping</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Reset">Reset to defaults</sys:String>
    <sys:String x:Key="VirtualControllerPage.Mapping.Target.None">None (disabled)</sys:String>
    <sys:String x:Key="VirtualControllerPage.Binding.Remove">Remove this binding</sys:String>
    <sys:String x:Key="VirtualControllerPage.Binding.OutputClick">click only</sys:String>
    <sys:String x:Key="VirtualControllerPage.Binding.SolosKept">solos kept</sys:String>
    <sys:String x:Key="DeviceInfoPage.Hiding.Title">Hide this controller</sys:String>
    <sys:String x:Key="DeviceInfoPage.Hiding.HideController.Description">Blocks other applications from seeing this physical controller.</sys:String>
    <sys:String x:Key="DeviceInfoPage.Hiding.Description.NotInstalled">The HidHide driver is not installed. Install it to hide controllers.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Title">Special Actions</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Description">Button combinations that execute actions (disconnect, lights)</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.New">Create a new special action</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Empty">No special actions yet. Use the add button to create one.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.ToolTip">Import special actions from a file</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Picker">Choose a special actions file</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.FileType">Special actions file</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Empty.Title">No special actions</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Empty.Message">The selected file contains no special actions.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Success.Title">Import complete</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Success.Message">Imported {count} special action(s). Enable them for this controller to use them.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Error.Title">Import failed</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Import.Error.Message">The special actions could not be imported.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Export.ToolTip">Export special actions to a file</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Export.Picker">Save special actions</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Export.Error.Title">Export failed</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Export.Error.Message">The special actions could not be exported.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Export.One">Export this special action to a file</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Export.One.Picker">Export special action</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Name">Name</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Delete">Delete this special action</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.EnabledForThisController">Enabled for this controller</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Combo">Button combination</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Combo.Hint">Held exactly as selected (no extra buttons). Fires once, re-arms after release.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Combo.None">No buttons</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Trigger">Trigger</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Trigger.Description">How the action fires: an exact button combination or a touchpad swipe. Only one trigger can be selected per action.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Trigger.Buttons">Button combination</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Trigger.Touchpad">Touchpad gesture</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Gesture">Swipe direction</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Gesture.Description">Swipe on the touchpad with one finger in this direction to trigger the action. Fires once per swipe.</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Gesture.SwipeUp">Swipe up</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Gesture.SwipeDown">Swipe down</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Gesture.SwipeLeft">Swipe left</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Gesture.SwipeRight">Swipe right</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.Cross">Cross</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.Circle">Circle</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.Square">Square</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.Triangle">Triangle</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.DPadUp">D-Pad Up</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.DPadDown">D-Pad Down</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.DPadLeft">D-Pad Left</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.DPadRight">D-Pad Right</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.L1">L1</sys:String>
    <sys:String x:Key="ProfilePage.SpecialActions.Button.R1">R1</sys:String>
