    <sys:String x:Key="AutoProfilesPage.Patterns.Hint">Program and window title are case-insensitive regular expressions, e.g. ^Level \d+$ or game\.exe$. An invalid expression matches literally instead. Escape backslashes as \\.</sys:String>
    <sys:String x:Key="AutoProfilesPage.Controller.Title">Controller</sys:String>
    <sys:String x:Key="AutoProfilesPage.Controller.Description">Which controller this rule applies to</sys:String>
    <sys:String x:Key="AutoProfilesPage.Controller.All">All controllers</sys:String>
    <sys:String x:Key="AutoProfilesPage.Profile.Title">Profile</sys:String>
    <sys:String x:Key="AutoProfilesPage.Profile.Description">Profile applied while the rule matches</sys:String>
    <sys:String x:Key="AutoProfilesPage.Profile.Unchanged">Leave unchanged</sys:String>
    <sys:String x:Key="AutoProfilesPage.Emulation.Title">Virtual controller</sys:String>
    <sys:String x:Key="AutoProfilesPage.Emulation.Description">Emulation mode applied while the rule matches</sys:String>
    <sys:String x:Key="AutoProfilesPage.Emulation.Unchanged">Leave unchanged</sys:String>
    <sys:String x:Key="AutoProfilesPage.Rules.NoAction">This rule leaves both profile and virtual controller unchanged, so it does nothing.</sys:String>
