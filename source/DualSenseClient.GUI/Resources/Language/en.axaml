<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      Localization conventions:
      - Sections are the key prefix (owning page or shared feature), in navigation order.
      - Inside a page, subsections are the second key component; two-part keys sit in "General".
      - Keys are sorted alphabetically within their subsection.
      Add new keys to the matching subsection; new shared-feature sections go last.
    -->

    <!-- MainWindow -->
    <!-- General -->
    <sys:String x:Key="MainWindow.AutoProfiles">Auto Profiles</sys:String>
    <sys:String x:Key="MainWindow.Customization">Customization</sys:String>
    <sys:String x:Key="MainWindow.Devices">Device Info</sys:String>
    <sys:String x:Key="MainWindow.Emulation">Emulation</sys:String>
    <sys:String x:Key="MainWindow.Settings">Settings</sys:String>
    <sys:String x:Key="MainWindow.Title">DualSense Client</sys:String>
    <!-- DisconnectController -->
    <sys:String x:Key="MainWindow.DisconnectController">Disconnect controller</sys:String>
    <sys:String x:Key="MainWindow.DisconnectController.Failed">{0} could not be disconnected</sys:String>
    <!-- ScanDevices -->
    <sys:String x:Key="MainWindow.ScanDevices.Start">Scan for controllers</sys:String>
    <sys:String x:Key="MainWindow.ScanDevices.Stop">Stop scanning</sys:String>

    <!-- Tray -->
    <sys:String x:Key="Tray.Disconnect">Disconnect</sys:String>
    <sys:String x:Key="Tray.Emulation">Virtual controller</sys:String>
    <sys:String x:Key="Tray.Exit">Exit</sys:String>
    <sys:String x:Key="Tray.NoControllers">No controllers connected</sys:String>
    <sys:String x:Key="Tray.Profiles">Profiles</sys:String>
    <sys:String x:Key="Tray.Select">Select</sys:String>
    <sys:String x:Key="Tray.Show">Show</sys:String>

    <!-- Notification -->
    <!-- AutoProfile -->
    <sys:String x:Key="Notification.AutoProfile.Message">{0} is now using {1}</sys:String>
    <sys:String x:Key="Notification.AutoProfile.Title">Auto profile switched</sys:String>
    <!-- Battery -->
    <sys:String x:Key="Notification.Battery.Message">{0}: {1}%</sys:String>
    <sys:String x:Key="Notification.Battery.Title">Battery level</sys:String>
    <!-- Changelog -->
    <sys:String x:Key="Notification.Changelog.Title">What's new</sys:String>
    <!-- Charged -->
    <sys:String x:Key="Notification.Charged.Message">{0} charged to {1}%</sys:String>
    <sys:String x:Key="Notification.Charged.Title">Controller charged</sys:String>
    <!-- Connected -->
    <sys:String x:Key="Notification.Connected.Message">{0} connected via {1}</sys:String>
    <sys:String x:Key="Notification.Connected.Title">Controller connected</sys:String>
    <!-- Disconnected -->
    <sys:String x:Key="Notification.Disconnected.Message">{0} disconnected</sys:String>
    <sys:String x:Key="Notification.Disconnected.Title">Controller disconnected</sys:String>
    <!-- LowBattery -->
    <sys:String x:Key="Notification.LowBattery.Message">{0} battery is low ({1}%)</sys:String>
    <sys:String x:Key="Notification.LowBattery.Title">Low battery</sys:String>
    <!-- Test -->
    <sys:String x:Key="Notification.Test.Message">This is what notifications look like.</sys:String>
    <sys:String x:Key="Notification.Test.Title">Test notification</sys:String>
    <!-- Update -->
    <sys:String x:Key="Notification.Update.Downloading.Message">Downloading version {0}… {1:F0}%</sys:String>
    <sys:String x:Key="Notification.Update.Downloading.Title">Downloading update</sys:String>
    <sys:String x:Key="Notification.Update.Failed.Message">The update could not be installed. Click to open the release page.</sys:String>
    <sys:String x:Key="Notification.Update.Failed.Title">Update failed</sys:String>
    <sys:String x:Key="Notification.Update.Message">Version {0} is available. Click to open the release page.</sys:String>
    <sys:String x:Key="Notification.Update.Restart.Message">Version {0} is downloaded. The app will now restart to apply the update.</sys:String>
    <sys:String x:Key="Notification.Update.Restart.Title">Restart to update</sys:String>
    <sys:String x:Key="Notification.Update.Title">Update available</sys:String>

    <!-- SplashScreen -->
    <sys:String x:Key="SplashScreen.CheckingUpdates">Checking for updates</sys:String>
    <sys:String x:Key="SplashScreen.LoadingProfiles">Loading profiles</sys:String>
    <sys:String x:Key="SplashScreen.ScanningControllers">Scanning for controllers</sys:String>
    <sys:String x:Key="SplashScreen.StartingServices">Starting services</sys:String>

    <!-- MessageBox -->
    <sys:String x:Key="MessageBox.Cancel">Cancel</sys:String>
    <sys:String x:Key="MessageBox.No">No</sys:String>
    <sys:String x:Key="MessageBox.Ok">OK</sys:String>
    <sys:String x:Key="MessageBox.Yes">Yes</sys:String>

