    <sys:String x:Key="ProfilePage.Emulation.DeviceType.Edge">DualSense Edge</sys:String>
    <sys:String x:Key="ProfilePage.Emulation.AudioOutput">Forwarded audio output</sys:String>
    <sys:String x:Key="ProfilePage.Emulation.AudioOutput.Description">Where host audio is played back on the physical controller.</sys:String>
