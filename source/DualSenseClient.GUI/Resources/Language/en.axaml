<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Add UI Strings Here -->
    <sys:String x:Key="MainWindow.Title">DualSenseClient</sys:String>
    <sys:String x:Key="MainWindow.Settings">Settings</sys:String>

    <!-- Title Bar -->
    <sys:String x:Key="MainWindow.ScanDevices.Start">Scan for controllers</sys:String>
    <sys:String x:Key="MainWindow.ScanDevices.Stop">Stop scanning</sys:String>

    <!-- Splash Screen -->
    <sys:String x:Key="SplashScreen.LoadingProfiles">Loading profiles...</sys:String>

    <!-- Device Info Page -->
    <sys:String x:Key="MainWindow.Devices">Device Info</sys:String>
    <sys:String x:Key="DeviceInfoPage.NoDevice.Title">No controller selected</sys:String>
    <sys:String x:Key="DeviceInfoPage.NoDevice.Description">Select a controller from the title bar to view its firmware and hardware information.</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Title">Device</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Description">Controller identification</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.Name">Name</sys:String>
    <sys:String x:Key="DeviceInfoPage.Device.ConnectionType">Connection</sys:String>
    <sys:String x:Key="DeviceInfoPage.Pairing.Title">Pairing</sys:String>
    <sys:String x:Key="DeviceInfoPage.Pairing.Description">Bluetooth MAC addresses</sys:String>
    <sys:String x:Key="DeviceInfoPage.Pairing.ClientMac">Controller MAC</sys:String>
    <sys:String x:Key="DeviceInfoPage.Pairing.HostMac">Host MAC</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Title">Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Description">Version and build information</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.Refresh">Re-read firmware info</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.MainVersion">Main Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.SblVersion">SBL Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.DspVersion">DSP Firmware</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.McuDspVersion">MCU/Spider DSP</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.ModelRevision">Model Revision</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.BuildDate">Build Date</sys:String>
    <sys:String x:Key="DeviceInfoPage.Firmware.BuildTime">Build Time</sys:String>

    <!-- Device Info Page: Battery -->
    <sys:String x:Key="DeviceInfoPage.Battery.Title">Battery</sys:String>
    <sys:String x:Key="DeviceInfoPage.Battery.Description">Power level and charging state</sys:String>
    <sys:String x:Key="DeviceInfoPage.Battery.Level">Level</sys:String>
    <sys:String x:Key="DeviceInfoPage.Battery.PowerState">Power State</sys:String>

    <!-- Device Info Page: Connection Status -->
    <sys:String x:Key="DeviceInfoPage.Connection.Title">Connection Status</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Description">Audio and USB connection state</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Headphones">Headphones</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.Microphone">Microphone</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.MicrophoneMuted">Microphone Muted</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.UsbData">USB Data</sys:String>
    <sys:String x:Key="DeviceInfoPage.Connection.UsbPower">USB Power</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Yes">Yes</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.No">No</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Connected">Connected</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.NotConnected">Not connected</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Active">Active</sys:String>
    <sys:String x:Key="DeviceInfoPage.Common.Inactive">Inactive</sys:String>

    <!-- MessageBox Strings -->
    <sys:String x:Key="MessageBox.Ok">OK</sys:String>
    <sys:String x:Key="MessageBox.Yes">Yes</sys:String>
    <sys:String x:Key="MessageBox.No">No</sys:String>
    <sys:String x:Key="MessageBox.Cancel">Cancel</sys:String>

    <!-- Input Monitor Page -->
    <sys:String x:Key="MainWindow.InputMonitor">Input Monitor</sys:String>
    <sys:String x:Key="MainWindow.Profile">Profile</sys:String>
    <sys:String x:Key="InputMonitorPage.NoDevice.Title">No controller selected</sys:String>
    <sys:String x:Key="InputMonitorPage.NoDevice.Description">Select a controller from the title bar to monitor its live input state.</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.Live">Live</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.Waiting">Waiting for reports</sys:String>
    <sys:String x:Key="InputMonitorPage.Status.Report">Report</sys:String>
    <sys:String x:Key="InputMonitorPage.Controller.Title">Controller</sys:String>
    <sys:String x:Key="InputMonitorPage.Controller.Description">Buttons, sticks, triggers, and touchpad</sys:String>
    <sys:String x:Key="InputMonitorPage.Buttons.Title">Buttons</sys:String>
    <sys:String x:Key="InputMonitorPage.Buttons.Description">Digital button state</sys:String>
    <sys:String x:Key="InputMonitorPage.Sticks.Title">Sticks</sys:String>
    <sys:String x:Key="InputMonitorPage.Sticks.Description">Analog stick position</sys:String>
    <sys:String x:Key="InputMonitorPage.Sticks.Left">Left Stick</sys:String>
    <sys:String x:Key="InputMonitorPage.Sticks.Right">Right Stick</sys:String>
    <sys:String x:Key="InputMonitorPage.Sticks.X">X</sys:String>
    <sys:String x:Key="InputMonitorPage.Sticks.Y">Y</sys:String>
    <sys:String x:Key="InputMonitorPage.Triggers.Title">Triggers</sys:String>
    <sys:String x:Key="InputMonitorPage.Triggers.Description">Analog trigger position</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.Title">Motion</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.Description">IMU gyroscope and accelerometer</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroX">Gyro X</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroY">Gyro Y</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroZ">Gyro Z</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelX">Accel X</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelY">Accel Y</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelZ">Accel Z</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.GyroGraph.Title">Gyroscope graph</sys:String>
    <sys:String x:Key="InputMonitorPage.Motion.AccelGraph.Title">Accelerometer graph</sys:String>
    <sys:String x:Key="InputMonitorPage.Touchpad.Title">Touchpad</sys:String>
    <sys:String x:Key="InputMonitorPage.Touchpad.Description">Touch surface</sys:String>
    <sys:String x:Key="InputMonitorPage.Touchpad.Touch1">Touch 1</sys:String>
    <sys:String x:Key="InputMonitorPage.Touchpad.Touch2">Touch 2</sys:String>
    <sys:String x:Key="InputMonitorPage.Common.Active">Active</sys:String>
    <sys:String x:Key="InputMonitorPage.Common.Inactive">Inactive</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.Cross">Cross</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.Circle">Circle</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.Square">Square</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.Triangle">Triangle</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.DPadUp">D-Pad Up</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.DPadDown">D-Pad Down</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.DPadLeft">D-Pad Left</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.DPadRight">D-Pad Right</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.L1">L1</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.R1">R1</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.L2">L2</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.R2">R2</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.L3">L3</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.R3">R3</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.Create">Create</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.Options">Options</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.PS">PS</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.TouchPad">Touchpad</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.Mute">Mute</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.FnL">FnL</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.FnR">FnR</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.L4">L4</sys:String>
    <sys:String x:Key="InputMonitorPage.Button.R4">R4</sys:String>

    <!-- Input Monitor Page: Output Test -->
    <sys:String x:Key="InputMonitorPage.OutputTest.Title">Output Test</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Description">Vibration and adaptive trigger testing</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Title">Vibration</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Left">Left Motor</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Right">Right Motor</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Enable">Rumble</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Vibration.Strength">Strength</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Title">Adaptive Triggers</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Left">L2</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Right">R2</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode">Effect mode</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Off">Off</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Resistance">Resistance</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Trigger">Trigger (weapon)</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Mode.Automatic">Automatic (vibration)</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Start">Start position</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.End">End position</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Force">Force</sys:String>
    <sys:String x:Key="InputMonitorPage.OutputTest.Triggers.Frequency">Frequency</sys:String>

    <!-- Profile Page -->
    <sys:String x:Key="ProfilePage.NoDevice.Title">No controller selected</sys:String>
    <sys:String x:Key="ProfilePage.NoDevice.Description">Select a DualSense controller from the title bar to customize its profile.</sys:String>
    <sys:String x:Key="ProfilePage.Lights.Title">Lights</sys:String>
    <sys:String x:Key="ProfilePage.Lights.Description">Lightbar color, microphone LED, and player indicators</sys:String>
    <sys:String x:Key="ProfilePage.Controller.Title">Controller</sys:String>
    <sys:String x:Key="ProfilePage.Controller.Description">Profile assignment for the selected controller</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Title">Assigned profile</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Description">Applied automatically when this controller connects</sys:String>
    <sys:String x:Key="ProfilePage.AssignedProfile.Reapply">Re-apply profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Title">Profiles</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Description">Create, edit, and manage saved light profiles</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.New">Create a new profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Duplicate">Duplicate the selected profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Delete">Delete the selected profile</sys:String>
    <sys:String x:Key="ProfilePage.Profiles.Empty">No profiles yet. Use the add button to create one.</sys:String>
    <sys:String x:Key="ProfilePage.Name.Title">Name</sys:String>
    <sys:String x:Key="ProfilePage.Delete.Title">Delete profile</sys:String>
    <sys:String x:Key="ProfilePage.Delete.Message">Delete profile "{name}"? Controllers assigned to it will fall back to the default profile.</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Title">Lightbar</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Red">Red</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Green">Green</sys:String>
    <sys:String x:Key="ProfilePage.Lightbar.Blue">Blue</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Title">Microphone LED</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode">Mode</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.Off">Off</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.On">On</sys:String>
    <sys:String x:Key="ProfilePage.MicLed.Mode.Pulse">Pulse</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Title">Player LEDs</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led1">LED 1</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led2">LED 2</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led3">LED 3</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led4">LED 4</sys:String>
    <sys:String x:Key="ProfilePage.PlayerLeds.Led5">LED 5</sys:String>

    <!-- Settings Page -->
    <sys:String x:Key="SettingsPage.Ui.Title">UI</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Description">Language and theme settings</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Title">Language</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Description">Select the application language</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Title">Theme</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Description">Select the application theme</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.System">System</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Light">Light</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Dark">Dark</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Title">Debug</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Description">Logging and diagnostics</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Title">Log Level</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Description">Set the minimum logging verbosity</sys:String>
</ResourceDictionary>