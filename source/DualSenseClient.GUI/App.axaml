<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DualSenseClient.GUI.App"
             xmlns:faStyle="using:FluentAvalonia.Styling"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="clr-namespace:DualSenseClient.GUI.Converters"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <converters:NotNullConverter x:Key="NotNullConverter" />
            <converters:DoubleFormatConverter x:Key="DoubleFormatConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <faStyle:FluentAvaloniaTheme PreferSystemTheme="True"
                                     PreferUserAccentColor="False" />
        <!-- App typography: Inter everywhere, falling back to the system UI font -->
        <Style Selector="Window,PopupRoot">
            <Setter Property="FontFamily"
                    Value="avares://Avalonia.Fonts.Inter/Assets#Inter,Segoe UI" />
        </Style>
        <!-- Remove icon-placeholder indent for FASettingsExpanderItems without their own icon.
             Items with :icon keep the default SettingsExpanderItemContentMargin (42 0 0 0). -->
        <Style Selector="ui|FASettingsExpanderItem:iconPlaceholder:not(:icon) /template/ StackPanel#HeaderRegion">
            <Setter Property="Margin"
                    Value="0" />
        </Style>
        <!-- Custom Controls -->
        <StyleInclude Source="/Controls/Controls.axaml" />
    </Application.Styles>
</Application>