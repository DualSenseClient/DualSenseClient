<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:vm="using:DualSenseClient.GUI.ViewModels"
                       xmlns:views="clr-namespace:DualSenseClient.GUI.Views"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                       xmlns:controls="using:FluentAvalonia.UI.Controls"
                       mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                       x:Class="DualSenseClient.GUI.Views.MainWindow"
                       x:DataType="vm:MainWindowViewModel"
                       Icon="/Assets/icon.ico"
                       Title="{Binding WindowTitle}"
                       MinWidth="820"
                       MinHeight="320">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Grid>
        <views:MainView />
        <controls:FAInfoBar x:Name="InfoBar"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="{Binding Severity, RelativeSource={RelativeSource Self}, Converter={StaticResource InfoBarSeverityToBackgroundConverter}}"
                            IsClosable="True" />
    </Grid>
</windowing:FAAppWindow>