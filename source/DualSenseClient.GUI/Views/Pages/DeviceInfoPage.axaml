<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseClient.GUI.ViewModels.Pages"
             xmlns:cards="clr-namespace:DualSenseClient.GUI.Controls.Cards"
             xmlns:controls="clr-namespace:DualSenseClient.GUI.Controls"
             xmlns:settings="using:DualSenseClient.Settings"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DualSenseClient.GUI.Views.Pages.DeviceInfoPage"
             x:DataType="vm:DeviceInfoPageViewModel">
    <Design.DataContext>
        <vm:DeviceInfoPageViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="24">
            <!-- Empty state shown when no controller is selected -->
            <cards:EmptyStateCard Title="{DynamicResource DeviceInfoPage.NoDevice.Title}"
                                  Description="{DynamicResource DeviceInfoPage.NoDevice.Description}"
                                  IsVisible="{Binding !HasDevice}" />

            <!-- Device -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource DeviceInfoPage.Device.Title}"
                                      Description="{DynamicResource DeviceInfoPage.Device.Description}"
                                      Icon="{x:Static fic:Symbol.PeopleGameController}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <cards:CustomCard>
                        <controls:DualSenseControllerView State="{Binding MonitorState}"
                                                          SkinName="{Binding SkinName}"
                                                          ShowMovement="False"
                                                          ShowButtonPresses="False"
                                                          ShowStats="False"
                                                          HorizontalAlignment="Center" />
                    </cards:CustomCard>
                    <cards:TextBoxCard Title="{DynamicResource DeviceInfoPage.Device.Name}"
                                       Text="{Binding ControllerName}"
                                       MaxLength="{x:Static settings:ControllerInfoService.MaxNameLength}"
                                       TextBoxMaxWidth="300" />
                    <cards:ComboBoxCard Title="{DynamicResource DeviceInfoPage.Device.Skin}"
                                        Description="{DynamicResource DeviceInfoPage.Device.Skin.Description}"
                                        ItemsSource="{Binding Skins}"
                                        SelectedIndex="{Binding SkinIndex}" />
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Device.ConnectionType}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.ConnectionType}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Pairing.ClientMac}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.ClientMac}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>

                    <!-- Battery -->
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Battery.Level}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Command="{Binding ToggleBatteryDisplayCommand}"
                                        IsVisible="{Binding ShowBatteryPercentage}"
                                        ToolTip.Tip="{Binding CurrentDevice.BatteryPercentage}"
                                        Padding="8,4">
                                    <TextBlock Text="{Binding CurrentDevice.BatteryPercentage}" />
                                </Button>
                                <Button Command="{Binding ToggleBatteryDisplayCommand}"
                                        IsVisible="{Binding ShowBatteryIcon}"
                                        ToolTip.Tip="{Binding CurrentDevice.BatteryPercentage}"
                                        Padding="8,4">
                                    <ic:FluentIcon Icon="{Binding CurrentDevice.BatteryIcon}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </cards:CustomCard>

                    <!-- Hide this controller -->
                    <cards:ToggleSwitchCard Title="{DynamicResource DeviceInfoPage.Hiding.Title}"
                                            Description="{Binding HidingDescription}"
                                            IsChecked="{Binding IsControllerHidden}"
                                            IsEnabled="{Binding CanHideController}"
                                            IsVisible="{Binding IsHidingVisible}" />

                    <!-- Virtual controller emulation -->
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <cards:CardHeader Title="{DynamicResource DeviceInfoPage.Emulation.Title}"
                                              Description="{DynamicResource DeviceInfoPage.Emulation.Mode.Description}"
                                              Icon="{x:Static fic:Symbol.XboxController}"
                                              MinHeight="56" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <cards:ComboBoxCard Title="{DynamicResource DeviceInfoPage.Emulation.Mode}"
                                                ItemsSource="{Binding EmulationModes}"
                                                SelectedIndex="{Binding EmulationModeIndex}"
                                                IsEnabled="{Binding CanChangeEmulation}" />
                            <cards:ComboBoxCard Title="{DynamicResource DeviceInfoPage.Emulation.DeviceType}"
                                                Description="{DynamicResource DeviceInfoPage.Emulation.DeviceType.Description}"
                                                ItemsSource="{Binding DualSenseVariants}"
                                                SelectedIndex="{Binding DualSenseVariantIndex}"
                                                IsVisible="{Binding IsDualSenseEmulation}"
                                                IsEnabled="{Binding CanChangeEmulation}" />
                            <cards:ComboBoxCard Title="{DynamicResource DeviceInfoPage.Emulation.AudioOutput}"
                                                Description="{DynamicResource DeviceInfoPage.Emulation.AudioOutput.Description}"
                                                ItemsSource="{Binding EmulationAudioOutputs}"
                                                SelectedIndex="{Binding ForwardAudioOutputIndex}"
                                                IsVisible="{Binding IsAudioEmulation}" />
                            <cards:SliderCard Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              Title="{DynamicResource DeviceInfoPage.Emulation.ForwardVolume}"
                                              Value="{Binding ForwardVolume}"
                                              IsVisible="{Binding IsAudioEmulation}" />
                            <cards:SliderCard Minimum="0"
                                              Maximum="200"
                                              TickFrequency="1"
                                              Title="{DynamicResource DeviceInfoPage.Emulation.ForwardHaptics}"
                                              Value="{Binding ForwardHapticStrength}"
                                              IsVisible="{Binding IsAudioEmulation}" />
                            <TextBlock Text="{Binding EmulationStatusText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Connection Status -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="False">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource DeviceInfoPage.Connection.Title}"
                                      Description="{DynamicResource DeviceInfoPage.Connection.Description}"
                                      Icon="{x:Static fic:Symbol.PlugConnected}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Battery.PowerState}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.PowerState}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Connection.Headphones}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.Headphones}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Connection.Microphone}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.Microphone}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Connection.MicrophoneMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.MicrophoneMuted}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Connection.UsbData}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.UsbData}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Connection.UsbPower}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.UsbPower}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                </StackPanel>
            </Expander>

            <!-- Firmware -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="False">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource DeviceInfoPage.Firmware.Title}"
                                      Description="{DynamicResource DeviceInfoPage.Firmware.Description}"
                                      Icon="{x:Static fic:Symbol.Gauge}"
                                      MinHeight="64">
                        <cards:CardHeader.ActionContent>
                            <Button Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="{DynamicResource DeviceInfoPage.Firmware.Refresh}">
                                <ic:FluentIcon Icon="ArrowSync"
                                               IconVariant="Regular" />
                            </Button>
                        </cards:CardHeader.ActionContent>
                    </cards:CardHeader>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.MainVersion}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.MainFirmwareVersion}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.SblVersion}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.SblFirmwareVersion}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.DspVersion}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.DspFirmwareVersion}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.McuDspVersion}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.McuSpiderDspFirmwareVersion}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.ModelRevision}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.ModelRevision}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.HardwareVersion}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.HardwareVersion}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.HardwareGeneration}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.HardwareGeneration}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.BuildDate}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.BuildDate}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource DeviceInfoPage.Firmware.BuildTime}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.BuildTime}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>