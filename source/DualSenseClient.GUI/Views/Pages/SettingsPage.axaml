<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseClient.GUI.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:icm="using:FluentIcons.Avalonia.Fluent.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="900"
             x:Class="DualSenseClient.GUI.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
    <Design.DataContext>
        <vm:SettingsPageViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Spacing="4"
                    Margin="24,12,24,24">
            <!-- App header -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="15"
                  Margin="0,0,0,16">
                <Border Width="80"
                        Height="80"
                        Padding="6"
                        CornerRadius="8"
                        Background="{DynamicResource SystemAccentColor}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Image Source="/Assets/icon-transparent.png" />
                </Border>
                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            Spacing="5"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SettingsPage.Header.AppName}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding ApplicationVersion, Mode=OneTime}"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="1,0,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <HyperlinkButton NavigateUri="https://github.com/DualSenseClient/DualSenseClient"
                                         Content="{DynamicResource SettingsPage.Header.Github}"
                                         FontSize="12"
                                         Margin="-10,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Command="{Binding CheckForUpdatesCommand}"
                            IsVisible="{Binding !HasUpdate}"
                            IsEnabled="{Binding !IsChecking}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <ic:FluentIcon Icon="ArrowDownload"
                                           IconVariant="Regular" />
                            <TextBlock Text="{DynamicResource SettingsPage.Updates.Check.Title}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ApplyUpdateCommand}"
                            IsVisible="{Binding HasUpdate}"
                            IsEnabled="{Binding !IsChecking}"
                            ToolTip.Tip="{DynamicResource SettingsPage.Updates.Open.Description}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <ic:FluentIcon Icon="ArrowDownload"
                                           IconVariant="Regular" />
                            <TextBlock Text="{DynamicResource SettingsPage.Updates.Open.Title}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Updates -->
            <ui:FASettingsExpander Header="{DynamicResource SettingsPage.Updates.Title}"
                                   Description="{DynamicResource SettingsPage.Updates.Description}"
                                   IconSource="{icm:SymbolIconSource Symbol=ArrowSync}"
                                   IsExpanded="False">
                <ui:FASettingsExpanderItem Content="{Binding ChannelLabel}"
                                           Description="{DynamicResource SettingsPage.Updates.Channel.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding IncludeNightlyUpdates, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Updates.AutoCheck.Title}"
                                           Description="{DynamicResource SettingsPage.Updates.AutoCheck.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- UI settings -->
            <ui:FASettingsExpander Header="{DynamicResource SettingsPage.Ui.Title}"
                                   Description="{DynamicResource SettingsPage.Ui.Description}"
                                   IconSource="{icm:SymbolIconSource Symbol=PaintBrush}"
                                   IsExpanded="False">
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Ui.Language.Title}"
                                           Description="{DynamicResource SettingsPage.Ui.Language.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding AppLanguages}"
                                  SelectedIndex="{Binding SelectedLanguageIndex}"
                                  MinWidth="220" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Ui.Theme.Title}"
                                           Description="{DynamicResource SettingsPage.Ui.Theme.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding AppThemeOptions}"
                                  SelectedIndex="{Binding SelectedThemeIndex}"
                                  MinWidth="220" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Ui.Mica.Title}"
                                           Description="{DynamicResource SettingsPage.Ui.Mica.Description}"
                                           IsVisible="{Binding IsMicaOptionVisible}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding MicaEnabled, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- Window settings -->
            <ui:FASettingsExpander Header="{DynamicResource SettingsPage.Window.Title}"
                                   Description="{DynamicResource SettingsPage.Window.Description}"
                                   IconSource="{icm:SymbolIconSource Symbol=Window}"
                                   IsExpanded="False">
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Window.CloseToTray.Title}"
                                           Description="{DynamicResource SettingsPage.Window.CloseToTray.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Window.StartInTray.Title}"
                                           Description="{DynamicResource SettingsPage.Window.StartInTray.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding StartInTray, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Window.BatteryPercentage.Title}"
                                           Description="{DynamicResource SettingsPage.Window.BatteryPercentage.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ShowBatteryPercentage, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!-- Notifications -->
            <ui:FASettingsExpander Header="{DynamicResource SettingsPage.Notifications.Title}"
                                   Description="{DynamicResource SettingsPage.Notifications.Description}"
                                   IconSource="{icm:SymbolIconSource Symbol=Alert}"
                                   IsExpanded="False">
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.Enable.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.Enable.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Notifications, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.Position.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.Position.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding NotificationPositionOptions}"
                                  SelectedIndex="{Binding SelectedNotificationPositionIndex}"
                                  MinWidth="220" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.Duration.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.Duration.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="1"
                                       Maximum="30"
                                       Value="{Binding NotificationDurationSeconds}"
                                       Width="160" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.Connection.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.Connection.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding NotifyOnConnection, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.LowBattery.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.LowBattery.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding NotifyOnLowBattery, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.LowThreshold.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.LowThreshold.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="5"
                                       Maximum="50"
                                       Value="{Binding LowBatteryThreshold}"
                                       Width="160" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.Charge.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.Charge.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding NotifyOnCharge, Mode=TwoWay}" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.ChargeThreshold.Title}"
                                           Description="{DynamicResource SettingsPage.Notifications.ChargeThreshold.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <NumericUpDown Minimum="50"
                                       Maximum="100"
                                       Value="{Binding ChargeThreshold}"
                                       Width="160" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Notifications.Test.Title}"
                                           IsClickEnabled="True"
                                           Command="{Binding TestNotificationCommand}"
                                           ActionIconSource="{icm:SymbolIconSource Symbol=Megaphone}" />
            </ui:FASettingsExpander>

            <!-- Debug -->
            <ui:FASettingsExpander Header="{DynamicResource SettingsPage.Debug.Title}"
                                   Description="{DynamicResource SettingsPage.Debug.Description}"
                                   IconSource="{icm:SymbolIconSource Symbol=Bug}"
                                   IsExpanded="False">
                <ui:FASettingsExpanderItem Content="{DynamicResource SettingsPage.Debug.LogLevel.Title}"
                                           Description="{DynamicResource SettingsPage.Debug.LogLevel.Description}">
                    <ui:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding LogLevels}"
                                  SelectedIndex="{Binding SelectedLogLevelIndex}"
                                  MinWidth="220" />
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>