<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseClient.GUI.ViewModels.Pages"
             xmlns:cards="clr-namespace:DualSenseClient.GUI.Controls.Cards"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DualSenseClient.GUI.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
    <Design.DataContext>
        <vm:SettingsPageViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="24">
            <!-- App Header -->
            <TextBlock Text="{DynamicResource MainWindow.Settings}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
                <Image Source="/Assets/icon.png" Width="80" Height="80" VerticalAlignment="Center" />
                <StackPanel Orientation="Vertical" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SettingsPage.Header.AppName}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding ApplicationVersion, Mode=OneTime}"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="1,0,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <HyperlinkButton NavigateUri="https://github.com/shazzaam7/DualSenseClient"
                                         Content="{DynamicResource SettingsPage.Header.Github}"
                                         FontSize="12"
                                         Margin="-10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- UI Settings -->
            <Expander>
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource SettingsPage.Ui.Title}"
                                      Description="{DynamicResource SettingsPage.Ui.Description}"
                                      Icon="{x:Static fic:Symbol.WindowWrench}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <!-- Language -->
                    <cards:ComboBoxCard Icon="{x:Static fic:Symbol.WindowText}"
                                        Title="{DynamicResource SettingsPage.Ui.Language.Title}"
                                        Description="{DynamicResource SettingsPage.Ui.Language.Description}"
                                        ItemsSource="{Binding AppLanguages}"
                                        SelectedIndex="{Binding SelectedLanguageIndex}" />
                    <!-- Theme -->
                    <cards:ComboBoxCard Icon="{x:Static fic:Symbol.WindowBrush}"
                                        Title="{DynamicResource SettingsPage.Ui.Theme.Title}"
                                        Description="{DynamicResource SettingsPage.Ui.Theme.Description}"
                                        ItemsSource="{Binding AppThemeOptions}"
                                        SelectedIndex="{Binding SelectedThemeIndex}" />
                </StackPanel>
            </Expander>
            <!-- Debug Settings -->
            <Expander>
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource SettingsPage.Debug.Title}"
                                      Description="{DynamicResource SettingsPage.Debug.Description}"
                                      Icon="{x:Static fic:Symbol.List}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <!-- Log Level -->
                    <cards:ComboBoxCard Icon="{x:Static fic:Symbol.List}"
                                        Title="{DynamicResource SettingsPage.Debug.LogLevel.Title}"
                                        Description="{DynamicResource SettingsPage.Debug.LogLevel.Description}"
                                        ItemsSource="{Binding LogLevels}"
                                        SelectedIndex="{Binding SelectedLogLevelIndex}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>