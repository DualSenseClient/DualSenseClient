<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseClient.GUI.ViewModels.Pages"
             xmlns:cards="clr-namespace:DualSenseClient.GUI.Controls.Cards"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="DualSenseClient.GUI.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
    <Design.DataContext>
        <vm:SettingsPageViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Spacing="16"
                    Margin="24">
            <!-- App Header -->
            <TextBlock Text="{DynamicResource MainWindow.Settings}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Orientation="Horizontal"
                        Spacing="15"
                        Margin="0,0,0,10">
                <Border Width="80"
                        Height="80"
                        Padding="6"
                        CornerRadius="8"
                        Background="{DynamicResource SystemAccentColor}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Image Source="/Assets/icon-transparent.png" />
                </Border>
                <StackPanel Orientation="Vertical"
                            Spacing="5"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SettingsPage.Header.AppName}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding ApplicationVersion, Mode=OneTime}"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="1,0,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <HyperlinkButton NavigateUri="https://github.com/DualSenseClient/DualSenseClient"
                                         Content="{DynamicResource SettingsPage.Header.Github}"
                                         FontSize="12"
                                         Margin="-10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- UI Settings -->
            <Expander>
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource SettingsPage.Ui.Title}"
                                      Description="{DynamicResource SettingsPage.Ui.Description}"
                                      Icon="{x:Static fic:Symbol.PaintBrush}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <!-- Language -->
                    <cards:ComboBoxCard Icon="{x:Static fic:Symbol.LocalLanguageGlobe}"
                                        Title="{DynamicResource SettingsPage.Ui.Language.Title}"
                                        Description="{DynamicResource SettingsPage.Ui.Language.Description}"
                                        ItemsSource="{Binding AppLanguages}"
                                        SelectedIndex="{Binding SelectedLanguageIndex}" />
                    <!-- Theme -->
                    <cards:ComboBoxCard Icon="{x:Static fic:Symbol.CircleHalfFill}"
                                        Title="{DynamicResource SettingsPage.Ui.Theme.Title}"
                                        Description="{DynamicResource SettingsPage.Ui.Theme.Description}"
                                        ItemsSource="{Binding AppThemeOptions}"
                                        SelectedIndex="{Binding SelectedThemeIndex}" />
                </StackPanel>
            </Expander>
            <!-- Window Settings -->
            <Expander>
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource SettingsPage.Window.Title}"
                                      Description="{DynamicResource SettingsPage.Window.Description}"
                                      Icon="{x:Static fic:Symbol.Window}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <!-- Close to Tray -->
                    <cards:ToggleSwitchCard Icon="{x:Static fic:Symbol.ShareCloseTray}"
                                            Title="{DynamicResource SettingsPage.Window.CloseToTray.Title}"
                                            Description="{DynamicResource SettingsPage.Window.CloseToTray.Description}"
                                            IsChecked="{Binding CloseToTray}" />
                    <!-- Start in Tray -->
                    <cards:ToggleSwitchCard Icon="{x:Static fic:Symbol.ArrowMinimize}"
                                            Title="{DynamicResource SettingsPage.Window.StartInTray.Title}"
                                            Description="{DynamicResource SettingsPage.Window.StartInTray.Description}"
                                            IsChecked="{Binding StartInTray}" />
                    <!-- Show Battery Percentage -->
                    <cards:ToggleSwitchCard Icon="{x:Static fic:Symbol.Battery9}"
                                            Title="{DynamicResource SettingsPage.Window.BatteryPercentage.Title}"
                                            Description="{DynamicResource SettingsPage.Window.BatteryPercentage.Description}"
                                            IsChecked="{Binding ShowBatteryPercentage}" />
                </StackPanel>
            </Expander>
            <!-- Notifications -->
            <Expander>
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource SettingsPage.Notifications.Title}"
                                      Description="{DynamicResource SettingsPage.Notifications.Description}"
                                      Icon="{x:Static fic:Symbol.Alert}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <!-- Enable Notifications -->
                    <cards:ToggleSwitchCard Icon="{x:Static fic:Symbol.Alert}"
                                            Title="{DynamicResource SettingsPage.Notifications.Enable.Title}"
                                            Description="{DynamicResource SettingsPage.Notifications.Enable.Description}"
                                            IsChecked="{Binding Notifications}" />
                    <!-- Position -->
                    <cards:ComboBoxCard Icon="{x:Static fic:Symbol.TargetEdit}"
                                        Title="{DynamicResource SettingsPage.Notifications.Position.Title}"
                                        Description="{DynamicResource SettingsPage.Notifications.Position.Description}"
                                        ItemsSource="{Binding NotificationPositionOptions}"
                                        SelectedIndex="{Binding SelectedNotificationPositionIndex}" />
                    <!-- Duration -->
                    <cards:NumberBoxCard Icon="{x:Static fic:Symbol.AlertSnooze}"
                                         Title="{DynamicResource SettingsPage.Notifications.Duration.Title}"
                                         Description="{DynamicResource SettingsPage.Notifications.Duration.Description}"
                                         Minimum="1"
                                         Maximum="30"
                                         Value="{Binding NotificationDurationSeconds}" />
                    <!-- Connection Notifications -->
                    <cards:ToggleSwitchCard Icon="{x:Static fic:Symbol.PlugConnected}"
                                            Title="{DynamicResource SettingsPage.Notifications.Connection.Title}"
                                            Description="{DynamicResource SettingsPage.Notifications.Connection.Description}"
                                            IsChecked="{Binding NotifyOnConnection}" />
                    <!-- Low Battery Notifications -->
                    <cards:ToggleSwitchCard Icon="{x:Static fic:Symbol.BatteryWarning}"
                                            Title="{DynamicResource SettingsPage.Notifications.LowBattery.Title}"
                                            Description="{DynamicResource SettingsPage.Notifications.LowBattery.Description}"
                                            IsChecked="{Binding NotifyOnLowBattery}" />
                    <!-- Low Battery Threshold -->
                    <cards:NumberBoxCard Icon="{x:Static fic:Symbol.BatteryWarning}"
                                         Title="{DynamicResource SettingsPage.Notifications.LowThreshold.Title}"
                                         Description="{DynamicResource SettingsPage.Notifications.LowThreshold.Description}"
                                         Minimum="5"
                                         Maximum="50"
                                         Value="{Binding LowBatteryThreshold}" />
                    <!-- Charge Notifications -->
                    <cards:ToggleSwitchCard Icon="{x:Static fic:Symbol.BatteryCharge}"
                                            Title="{DynamicResource SettingsPage.Notifications.Charge.Title}"
                                            Description="{DynamicResource SettingsPage.Notifications.Charge.Description}"
                                            IsChecked="{Binding NotifyOnCharge}" />
                    <!-- Charge Threshold -->
                    <cards:NumberBoxCard Icon="{x:Static fic:Symbol.BatteryCharge}"
                                         Title="{DynamicResource SettingsPage.Notifications.ChargeThreshold.Title}"
                                         Description="{DynamicResource SettingsPage.Notifications.ChargeThreshold.Description}"
                                         Minimum="50"
                                         Maximum="100"
                                         Value="{Binding ChargeThreshold}" />
                    <Button Command="{Binding TestNotificationCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <ic:FluentIcon Icon="Megaphone"
                                           IconVariant="Regular" />
                            <TextBlock Text="{DynamicResource SettingsPage.Notifications.Test.Title}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>
            <!-- Debug Settings -->
            <Expander>
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource SettingsPage.Debug.Title}"
                                      Description="{DynamicResource SettingsPage.Debug.Description}"
                                      Icon="{x:Static fic:Symbol.Bug}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <!-- Log Level -->
                    <cards:ComboBoxCard Icon="{x:Static fic:Symbol.List}"
                                        Title="{DynamicResource SettingsPage.Debug.LogLevel.Title}"
                                        Description="{DynamicResource SettingsPage.Debug.LogLevel.Description}"
                                        ItemsSource="{Binding LogLevels}"
                                        SelectedIndex="{Binding SelectedLogLevelIndex}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>