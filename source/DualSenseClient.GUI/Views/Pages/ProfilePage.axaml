<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseClient.GUI.ViewModels.Pages"
             xmlns:items="using:DualSenseClient.GUI.Models.Items"
             xmlns:cards="clr-namespace:DualSenseClient.GUI.Controls.Cards"
             xmlns:controls="using:Avalonia.Controls"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DualSenseClient.GUI.Views.Pages.ProfilePage"
             x:DataType="vm:ProfilePageViewModel">
    <Design.DataContext>
        <vm:ProfilePageViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="24">
            <!-- Empty state shown when no controller is selected -->
            <cards:EmptyStateCard Title="{DynamicResource ProfilePage.NoDevice.Title}"
                                  Description="{DynamicResource ProfilePage.NoDevice.Description}"
                                  IsVisible="{Binding !HasDevice}" />

            <!-- Controller assignment -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource ProfilePage.Controller.Title}"
                                      Description="{DynamicResource ProfilePage.Controller.Description}"
                                      Icon="{x:Static fic:Symbol.Person}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="16">
                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="10"
                                    Background="{Binding CurrentDevice.LightbarBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDevice.DisplayName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentMac}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CurrentDevice.ColorHex}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>

                    <cards:ComboBoxCard Title="{DynamicResource ProfilePage.AssignedProfile.Title}"
                                        Description="{DynamicResource ProfilePage.AssignedProfile.Description}"
                                        ItemsSource="{Binding AssignedProfileOptions}"
                                        SelectedIndex="{Binding SelectedAssignedProfileIndex}" />
                    <Button Command="{Binding ReapplyProfileCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Replay"
                                           IconVariant="Regular" />
                            <TextBlock Text="{DynamicResource ProfilePage.AssignedProfile.Reapply}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>

            <!-- Profiles manager -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource ProfilePage.Profiles.Title}"
                                      Description="{DynamicResource ProfilePage.Profiles.Description}"
                                      Icon="{x:Static fic:Symbol.Lightbulb}"
                                      MinHeight="64">
                        <cards:CardHeader.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding CreateProfileCommand}"
                                        ToolTip.Tip="{DynamicResource ProfilePage.Profiles.New}">
                                    <ic:FluentIcon Icon="Add"
                                                   IconVariant="Regular" />
                                </Button>
                                <Button Command="{Binding DuplicateProfileCommand}"
                                        ToolTip.Tip="{DynamicResource ProfilePage.Profiles.Duplicate}">
                                    <ic:FluentIcon Icon="Copy"
                                                   IconVariant="Regular" />
                                </Button>
                                <Button Command="{Binding DeleteProfileCommand}"
                                        ToolTip.Tip="{DynamicResource ProfilePage.Profiles.Delete}">
                                    <ic:FluentIcon Icon="Delete"
                                                   IconVariant="Regular" />
                                </Button>
                            </StackPanel>
                        </cards:CardHeader.ActionContent>
                    </cards:CardHeader>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             MaxHeight="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="items:ProfileEditorItem">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Border Width="16"
                                            Height="16"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{Binding LightbarBrush}" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource ProfilePage.Profiles.Empty}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding !HasSelectedProfile}" />

                    <!-- Editor for the selected profile -->
                    <StackPanel IsVisible="{Binding HasSelectedProfile}"
                                Spacing="8">
                        <cards:TextBoxCard Title="{DynamicResource ProfilePage.Name.Title}"
                                           Text="{Binding SelectedProfile.Name}" />

                        <!-- Lightbar color -->
                        <TextBlock Text="{DynamicResource ProfilePage.Lightbar.Title}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="16">
                            <controls:ColorView Grid.Column="0"
                                                Width="320"
                                                Color="{Binding SelectedProfile.LightbarColor}"
                                                IsColorSpectrumVisible="True"
                                                IsColorPaletteVisible="True"
                                                IsColorComponentsVisible="False"
                                                IsColorPreviewVisible="True"
                                                IsAlphaEnabled="False"
                                                IsAlphaVisible="False" />
                            <Grid Grid.Column="1"
                                  RowDefinitions="Auto,*,Auto,*,Auto">
                                <cards:SliderCard Grid.Row="0"
                                                  Minimum="0"
                                                  Maximum="255"
                                                  TickFrequency="1"
                                                  Title="{DynamicResource ProfilePage.Lightbar.Red}"
                                                  Value="{Binding SelectedProfile.LedRed}" />
                                <cards:SliderCard Grid.Row="2"
                                                  Minimum="0"
                                                  Maximum="255"
                                                  TickFrequency="1"
                                                  Title="{DynamicResource ProfilePage.Lightbar.Green}"
                                                  Value="{Binding SelectedProfile.LedGreen}" />
                                <cards:SliderCard Grid.Row="4"
                                                  Minimum="0"
                                                  Maximum="255"
                                                  TickFrequency="1"
                                                  Title="{DynamicResource ProfilePage.Lightbar.Blue}"
                                                  Value="{Binding SelectedProfile.LedBlue}" />
                            </Grid>
                        </Grid>

                        <!-- Microphone LED -->
                        <TextBlock Text="{DynamicResource ProfilePage.MicLed.Title}"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0" />
                        <cards:ComboBoxCard Title="{DynamicResource ProfilePage.MicLed.Mode}"
                                            ItemsSource="{Binding MicLedModes}"
                                            SelectedIndex="{Binding SelectedProfile.MuteLedMode}" />

                        <!-- Player LEDs -->
                        <TextBlock Text="{DynamicResource ProfilePage.PlayerLeds.Title}"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0" />
                        <cards:CustomCard>
                            <UniformGrid Rows="1">
                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led1}"
                                              IsChecked="{Binding SelectedProfile.PlayerLed1}"
                                              HorizontalAlignment="Center" />
                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led2}"
                                              IsChecked="{Binding SelectedProfile.PlayerLed2}"
                                              HorizontalAlignment="Center" />
                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led3}"
                                              IsChecked="{Binding SelectedProfile.PlayerLed3}"
                                              HorizontalAlignment="Center" />
                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led4}"
                                              IsChecked="{Binding SelectedProfile.PlayerLed4}"
                                              HorizontalAlignment="Center" />
                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led5}"
                                              IsChecked="{Binding SelectedProfile.PlayerLed5}"
                                              HorizontalAlignment="Center" />
                            </UniformGrid>
                        </cards:CustomCard>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Special actions -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="False">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource ProfilePage.SpecialActions.Title}"
                                      Description="{DynamicResource ProfilePage.SpecialActions.Description}"
                                      Icon="{x:Static fic:Symbol.Pulse}"
                                      MinHeight="64">
                        <cards:CardHeader.ActionContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnImportSpecialActionsClick"
                                        ToolTip.Tip="{DynamicResource ProfilePage.SpecialActions.Import.ToolTip}">
                                    <ic:FluentIcon Icon="ArrowImport"
                                                   IconVariant="Regular" />
                                </Button>
                                <Button Click="OnExportSpecialActionsClick"
                                        ToolTip.Tip="{DynamicResource ProfilePage.SpecialActions.Export.ToolTip}">
                                    <ic:FluentIcon Icon="ArrowExport"
                                                   IconVariant="Regular" />
                                </Button>
                                <Button Command="{Binding AddSpecialActionCommand}"
                                        ToolTip.Tip="{DynamicResource ProfilePage.SpecialActions.New}">
                                    <ic:FluentIcon Icon="Add"
                                                   IconVariant="Regular" />
                                </Button>
                            </StackPanel>
                        </cards:CardHeader.ActionContent>
                    </cards:CardHeader>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Empty}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding !HasSpecialActions}" />

                    <ListBox ItemsSource="{Binding SpecialActions}"
                             SelectedItem="{Binding SelectedSpecialAction}"
                             MaxHeight="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="items:SpecialActionItem">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ComboSummary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Editor for the selected special action -->
                    <ContentControl Content="{Binding SelectedSpecialAction}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="items:SpecialActionItem">
                                <cards:CustomCard>
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="8">
                                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                     PlaceholderText="{DynamicResource ProfilePage.SpecialActions.Name}" />
                                            <Button Grid.Column="1"
                                                    Click="OnExportSpecialActionClick"
                                                    ToolTip.Tip="{DynamicResource ProfilePage.SpecialActions.Export.One}">
                                                <ic:FluentIcon Icon="ArrowExport"
                                                               IconVariant="Regular" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip.Tip="{DynamicResource ProfilePage.SpecialActions.Delete}">
                                                <ic:FluentIcon Icon="Delete"
                                                               IconVariant="Regular" />
                                            </Button>
                                        </Grid>

                                        <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.EnabledForThisController}"
                                                      IsChecked="{Binding IsEnabledForThisController}"
                                                      HorizontalAlignment="Left" />

                                        <cards:ComboBoxCard Title="{DynamicResource ProfilePage.SpecialActions.Trigger}"
                                                            Description="{DynamicResource ProfilePage.SpecialActions.Trigger.Description}"
                                                            ComboBoxMinWidth="200"
                                                            ItemsSource="{Binding TriggerOptions}"
                                                            SelectedIndex="{Binding SelectedTriggerIndex}" />

                                        <cards:ComboBoxCard Title="{DynamicResource ProfilePage.SpecialActions.Gesture}"
                                                            Description="{DynamicResource ProfilePage.SpecialActions.Gesture.Description}"
                                                            ComboBoxMinWidth="200"
                                                            ItemsSource="{Binding GestureOptions}"
                                                            SelectedIndex="{Binding SelectedGestureIndex}"
                                                            IsVisible="{Binding HasGesture}" />

                                        <StackPanel Spacing="4"
                                                    IsVisible="{Binding !HasGesture}">
                                            <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Combo}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Combo.Hint}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ItemsControl ItemsSource="{Binding Buttons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="items:SpecialActionButtonItem">
                                                        <ToggleButton Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsChecked}"
                                                                      Margin="2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Effects.Title}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Effects.Description}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <WrapPanel>
                                            <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.Effects.Disconnect}"
                                                          IsChecked="{Binding EffectDisconnect}"
                                                          Margin="2" />
                                            <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.Effects.Lightbar}"
                                                          IsChecked="{Binding EffectLightbar}"
                                                          Margin="2" />
                                            <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.Effects.PlayerLeds}"
                                                          IsChecked="{Binding EffectPlayerLeds}"
                                                          Margin="2" />
                                            <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.Effects.Sound}"
                                                          IsChecked="{Binding EffectSound}"
                                                          Margin="2" />
                                            <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.Effects.Battery}"
                                                          IsChecked="{Binding EffectBattery}"
                                                          Margin="2" />
                                        </WrapPanel>

                                        <cards:NumberBoxCard Title="{DynamicResource ProfilePage.SpecialActions.HoldTime}"
                                                             Description="{DynamicResource ProfilePage.SpecialActions.HoldTime.Description}"
                                                             Minimum="0"
                                                             Maximum="10"
                                                             Value="{Binding HoldTimeSeconds}" />

                                        <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.ApplyWhileHeld}"
                                                      IsChecked="{Binding ApplyWhileHeld}"
                                                      IsVisible="{Binding IsApplyWhileHeldVisible}"
                                                      ToolTip.Tip="{DynamicResource ProfilePage.SpecialActions.ApplyWhileHeld.ToolTip}"
                                                      HorizontalAlignment="Left" />

                                        <cards:NumberBoxCard Title="{DynamicResource ProfilePage.SpecialActions.Duration}"
                                                             Description="{DynamicResource ProfilePage.SpecialActions.Duration.Description}"
                                                             Minimum="0"
                                                             Maximum="60"
                                                             Value="{Binding DurationSeconds}"
                                                             IsVisible="{Binding IsDurationVisible}" />

                                        <StackPanel Spacing="8"
                                                    IsVisible="{Binding IsColorAction}">
                                            <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Color}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0" />
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="16">
                                                <controls:ColorView Grid.Column="0"
                                                                    Width="320"
                                                                    Color="{Binding LightbarColor}"
                                                                    IsColorSpectrumVisible="True"
                                                                    IsColorPaletteVisible="True"
                                                                    IsColorComponentsVisible="False"
                                                                    IsColorPreviewVisible="True"
                                                                    IsAlphaEnabled="False"
                                                                    IsAlphaVisible="False" />
                                                <Grid Grid.Column="1"
                                                      RowDefinitions="Auto,*,Auto,*,Auto">
                                                    <cards:SliderCard Grid.Row="0"
                                                                      Minimum="0"
                                                                      Maximum="255"
                                                                      TickFrequency="1"
                                                                      Title="{DynamicResource ProfilePage.Lightbar.Red}"
                                                                      Value="{Binding LedRed}" />
                                                    <cards:SliderCard Grid.Row="2"
                                                                      Minimum="0"
                                                                      Maximum="255"
                                                                      TickFrequency="1"
                                                                      Title="{DynamicResource ProfilePage.Lightbar.Green}"
                                                                      Value="{Binding LedGreen}" />
                                                    <cards:SliderCard Grid.Row="4"
                                                                      Minimum="0"
                                                                      Maximum="255"
                                                                      TickFrequency="1"
                                                                      Title="{DynamicResource ProfilePage.Lightbar.Blue}"
                                                                      Value="{Binding LedBlue}" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="8"
                                                    IsVisible="{Binding IsPlayerLedsAction}">
                                            <TextBlock Text="{DynamicResource ProfilePage.PlayerLeds.Title}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0" />
                                            <UniformGrid Rows="1">
                                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led1}"
                                                              IsChecked="{Binding PlayerLed1}"
                                                              HorizontalAlignment="Center" />
                                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led2}"
                                                              IsChecked="{Binding PlayerLed2}"
                                                              HorizontalAlignment="Center" />
                                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led3}"
                                                              IsChecked="{Binding PlayerLed3}"
                                                              HorizontalAlignment="Center" />
                                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led4}"
                                                              IsChecked="{Binding PlayerLed4}"
                                                              HorizontalAlignment="Center" />
                                                <ToggleButton Content="{DynamicResource ProfilePage.PlayerLeds.Led5}"
                                                              IsChecked="{Binding PlayerLed5}"
                                                              HorizontalAlignment="Center" />
                                            </UniformGrid>
                                        </StackPanel>

                                        <StackPanel Spacing="8"
                                                    IsVisible="{Binding IsSoundAction}">
                                            <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Sound}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0" />
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBox Text="{Binding SoundPath, Mode=TwoWay}"
                                                         PlaceholderText="{DynamicResource ProfilePage.SpecialActions.Sound.Placeholder}" />
                                                <Button Grid.Column="1"
                                                        Click="OnBrowseSoundClick"
                                                        ToolTip.Tip="{DynamicResource ProfilePage.SpecialActions.Sound.Browse.ToolTip}">
                                                    <ic:FluentIcon Icon="FolderOpen"
                                                                   IconVariant="Regular"
                                                                   IconSize="Size16" />
                                                </Button>
                                            </Grid>
                                            <cards:ComboBoxCard Title="{DynamicResource ProfilePage.SpecialActions.Sound.Output}"
                                                                Description="{DynamicResource ProfilePage.SpecialActions.Sound.Output.Description}"
                                                                ComboBoxMinWidth="180"
                                                                ItemsSource="{Binding SoundOutputOptions}"
                                                                SelectedIndex="{Binding SelectedSoundOutputIndex}" />
                                            <cards:SliderCard Minimum="0"
                                                              Maximum="255"
                                                              TickFrequency="1"
                                                              Title="{DynamicResource ProfilePage.SpecialActions.Sound.Volume}"
                                                              Value="{Binding SoundVolume}" />
                                            <ToggleButton Content="{DynamicResource ProfilePage.SpecialActions.Sound.Haptics}"
                                                          IsChecked="{Binding HapticFeedback}"
                                                          HorizontalAlignment="Left" />
                                            <cards:SliderCard Minimum="0"
                                                              Maximum="200"
                                                              TickFrequency="1"
                                                              Title="{DynamicResource ProfilePage.SpecialActions.Sound.HapticStrength}"
                                                              Value="{Binding HapticStrength}"
                                                              IsVisible="{Binding IsHapticVisible}" />
                                        </StackPanel>

                                        <StackPanel Spacing="8"
                                                    IsVisible="{Binding IsBatteryAction}">
                                            <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Battery}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Battery.Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <cards:ComboBoxCard Title="{DynamicResource ProfilePage.SpecialActions.Battery.Level}"
                                                                Description="{DynamicResource ProfilePage.SpecialActions.Battery.Level.Description}"
                                                                ComboBoxMinWidth="200"
                                                                ItemsSource="{Binding BatteryLevels}"
                                                                SelectedIndex="{Binding SelectedBatteryLevel}">
                                                <cards:ComboBoxCard.ItemTemplate>
                                                    <DataTemplate x:DataType="items:BatteryLevelItem">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <Border Width="14"
                                                                    Height="14"
                                                                    CornerRadius="7"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding Brush}" />
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </cards:ComboBoxCard.ItemTemplate>
                                            </cards:ComboBoxCard>
                                            <Button Command="{Binding ResetBatteryColorsCommand}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{DynamicResource ProfilePage.SpecialActions.Battery.Reset}" />
                                            </Button>
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="16">
                                                <controls:ColorView Grid.Column="0"
                                                                    Width="320"
                                                                    Color="{Binding SelectedBatteryColor}"
                                                                    IsColorSpectrumVisible="True"
                                                                    IsColorPaletteVisible="True"
                                                                    IsColorComponentsVisible="False"
                                                                    IsColorPreviewVisible="True"
                                                                    IsAlphaEnabled="False"
                                                                    IsAlphaVisible="False" />
                                                <Grid Grid.Column="1"
                                                      RowDefinitions="Auto,*,Auto,*,Auto">
                                                    <cards:SliderCard Grid.Row="0"
                                                                      Minimum="0"
                                                                      Maximum="255"
                                                                      TickFrequency="1"
                                                                      Title="{DynamicResource ProfilePage.Lightbar.Red}"
                                                                      Value="{Binding SelectedBatteryRed}" />
                                                    <cards:SliderCard Grid.Row="2"
                                                                      Minimum="0"
                                                                      Maximum="255"
                                                                      TickFrequency="1"
                                                                      Title="{DynamicResource ProfilePage.Lightbar.Green}"
                                                                      Value="{Binding SelectedBatteryGreen}" />
                                                    <cards:SliderCard Grid.Row="4"
                                                                      Minimum="0"
                                                                      Maximum="255"
                                                                      TickFrequency="1"
                                                                      Title="{DynamicResource ProfilePage.Lightbar.Blue}"
                                                                      Value="{Binding SelectedBatteryBlue}" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </cards:CustomCard>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>