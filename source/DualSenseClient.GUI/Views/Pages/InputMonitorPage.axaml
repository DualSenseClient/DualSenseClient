<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseClient.GUI.ViewModels.Pages"
             xmlns:controls="using:DualSenseClient.GUI.Controls"
             xmlns:cards="clr-namespace:DualSenseClient.GUI.Controls.Cards"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DualSenseClient.GUI.Views.Pages.InputMonitorPage"
             x:DataType="vm:InputMonitorPageViewModel">
    <Design.DataContext>
        <vm:InputMonitorPageViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <!-- Button pill: released -->
        <Style Selector="Border.button-pill">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <!-- Button pill: pressed -->
        <Style Selector="Border.button-pill.pressed">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.button-pill.pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
        </Style>
        <!-- Button pill icons use the primary text color when released -->
        <Style Selector="Border.button-pill ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Button pill icons: white and filled when pressed -->
        <Style Selector="Border.button-pill.pressed ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
            <Setter Property="IconVariant" Value="Filled" />
        </Style>
        <!-- Touchpad surface: released -->
        <Style Selector="Border.touchpad-surface">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <!-- Touchpad surface: pressed (glows with the accent color) -->
        <Style Selector="Border.touchpad-surface.pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <!-- Button pad: compact D-pad / face button pill -->
        <Style Selector="Border.button-pill.pad">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextElement.FontSize" Value="11" />
        </Style>
        <!-- Round icon button used by the audio player transport controls -->
        <Style Selector="Button.audio-transport">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24">
            <!-- Empty state shown when no controller is selected -->
            <cards:EmptyStateCard Title="{DynamicResource InputMonitorPage.NoDevice.Title}"
                                  Description="{DynamicResource InputMonitorPage.NoDevice.Description}"
                                  IsVisible="{Binding !HasDevice}" />

            <!-- Live status strip -->
            <cards:CustomCard IsVisible="{Binding HasDevice}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Padding="8"
                                CornerRadius="6"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <ic:FluentIcon Icon="XboxController"
                                           IconVariant="Regular"
                                           Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding CurrentDevice.DisplayName}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentDevice.ConnectionType}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource InputMonitorPage.Status.Report}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentDevice.SequenceNumber}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <!-- Live badge; pulses while reports are flowing -->
                        <Border CornerRadius="999"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                IsVisible="{Binding CurrentDevice.HasReport}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{DynamicResource TextOnAccentFillColorSelectedTextBrush}"
                                         VerticalAlignment="Center">
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.5"
                                                           IterationCount="Infinite">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="50%">
                                                        <Setter Property="Opacity" Value="0.25" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource InputMonitorPage.Status.Live}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource InputMonitorPage.Status.Waiting}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !CurrentDevice.HasReport}" />
                    </StackPanel>
                </Grid>
            </cards:CustomCard>

            <!-- Controller: buttons, sticks, triggers, and touchpad laid out like a DualSense -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource InputMonitorPage.Controller.Title}"
                                      Description="{DynamicResource InputMonitorPage.Controller.Description}"
                                      Icon="{x:Static fic:Symbol.Joystick}"
                                      MinHeight="64" />
                </Expander.Header>
                <cards:CustomCard>
                    <StackPanel Spacing="16">
                        <!-- Asset-based controller visualization -->
                        <controls:DualSenseControllerView State="{Binding CurrentDevice}"
                                                          SkinName="{Binding SkinName}"
                                                          HorizontalAlignment="Center" />

                        <!-- Trigger and stick readouts -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <cards:CustomCard>
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource InputMonitorPage.Button.L2}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentDevice.L2}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource InputMonitorPage.Button.L3}"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                            <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.X}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CurrentDevice.LeftStickX}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="·"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.Y}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CurrentDevice.LeftStickY}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </cards:CustomCard>
                            <cards:CustomCard Grid.Column="1">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource InputMonitorPage.Button.R2}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentDevice.R2}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{DynamicResource InputMonitorPage.Button.R3}"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                            <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.X}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CurrentDevice.RightStickX}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="·"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.Y}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CurrentDevice.RightStickY}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </cards:CustomCard>
                        </Grid>

                        <!-- Touch info cards -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <cards:CustomCard>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{DynamicResource InputMonitorPage.Touchpad.Touch1}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentDevice.Touch1State}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentDevice.Touch1Position}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </cards:CustomCard>
                            <cards:CustomCard Grid.Column="1">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{DynamicResource InputMonitorPage.Touchpad.Touch2}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentDevice.Touch2State}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentDevice.Touch2Position}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </cards:CustomCard>
                        </Grid>
                        <!-- Edge function and back paddle buttons (DualSense Edge only) -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding CurrentDevice.IsEdge}">
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.FnL}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.FnL}" />
                            </Border>
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.L4}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.L4}" />
                            </Border>
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.R4}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.R4}" />
                            </Border>
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.FnR}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.FnR}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </cards:CustomCard>
            </Expander>

            <!-- Motion -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource InputMonitorPage.Motion.Title}"
                                      Description="{DynamicResource InputMonitorPage.Motion.Description}"
                                      Icon="{x:Static fic:Symbol.Gauge}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.GyroX}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.GyroX}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.GyroY}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.GyroY}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.GyroZ}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.GyroZ}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <cards:CardHeader Title="{DynamicResource InputMonitorPage.Motion.GyroGraph.Title}"
                                              Icon="{x:Static fic:Symbol.Gauge}"
                                              MinHeight="56" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <cards:CustomCard>
                                <controls:MotionGraph x:Name="GyroGraph"
                                                      Height="120"
                                                      Axis="Gyro"
                                                      SeriesXBrush="{DynamicResource MotionGraphXBrush}"
                                                      SeriesYBrush="{DynamicResource MotionGraphYBrush}"
                                                      SeriesZBrush="{DynamicResource MotionGraphZBrush}" />
                            </cards:CustomCard>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="16"
                                        HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphXBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="X"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphYBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Y"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphZBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Z"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.AccelX}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.AccelX}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.AccelY}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.AccelY}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.AccelZ}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.AccelZ}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <cards:CardHeader Title="{DynamicResource InputMonitorPage.Motion.AccelGraph.Title}"
                                              Icon="{x:Static fic:Symbol.Gauge}"
                                              MinHeight="56" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <cards:CustomCard>
                                <controls:MotionGraph x:Name="AccelGraph"
                                                      Height="120"
                                                      Axis="Accel"
                                                      SeriesXBrush="{DynamicResource MotionGraphXBrush}"
                                                      SeriesYBrush="{DynamicResource MotionGraphYBrush}"
                                                      SeriesZBrush="{DynamicResource MotionGraphZBrush}" />
                            </cards:CustomCard>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="16"
                                        HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphXBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="X"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphYBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Y"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphZBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Z"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Output Test: vibration and adaptive trigger testing -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource InputMonitorPage.OutputTest.Title}"
                                      Description="{DynamicResource InputMonitorPage.OutputTest.Description}"
                                      Icon="{x:Static fic:Symbol.Pulse}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Vibration.Title}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Vibration.Left}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ToggleSwitchCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Enable}"
                                                    IsChecked="{Binding CurrentDevice.LeftMotorEnabled, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Strength}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsEnabled="{Binding CurrentDevice.LeftMotorEnabled}"
                                              Value="{Binding CurrentDevice.LeftMotorStrength, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Vibration.Right}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ToggleSwitchCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Enable}"
                                                    IsChecked="{Binding CurrentDevice.RightMotorEnabled, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Strength}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsEnabled="{Binding CurrentDevice.RightMotorEnabled}"
                                              Value="{Binding CurrentDevice.RightMotorStrength, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Triggers.Title}"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0" />
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Triggers.Left}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ComboBoxCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Mode}"
                                                ItemsSource="{Binding CurrentDevice.TriggerEffectModes}"
                                                SelectedIndex="{Binding CurrentDevice.LeftTriggerModeIndex, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Start}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerStartVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerStart, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.End}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerEndVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerEnd, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Force}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerForceVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerForce, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Frequency}"
                                              Minimum="0"
                                              Maximum="15"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerFrequencyVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerFrequency, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Triggers.Right}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ComboBoxCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Mode}"
                                                ItemsSource="{Binding CurrentDevice.TriggerEffectModes}"
                                                SelectedIndex="{Binding CurrentDevice.RightTriggerModeIndex, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Start}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerStartVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerStart, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.End}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerEndVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerEnd, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Force}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerForceVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerForce, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Frequency}"
                                              Minimum="0"
                                              Maximum="15"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerFrequencyVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerFrequency, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Audio Player: play files to the desktop, controller speaker, headset, or haptics -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="False">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource InputMonitorPage.Audio.Title}"
                                      Description="{DynamicResource InputMonitorPage.Audio.Description}"
                                      Icon="{x:Static fic:Symbol.MusicNote2}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <!-- File picker and loaded file name -->
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    Margin="0,0,12,0"
                                    Padding="8"
                                    CornerRadius="6"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                <ic:FluentIcon Icon="MusicNote2"
                                               IconVariant="Regular"
                                               IconSize="Size16"
                                               Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDevice.Audio.FileName}"
                                           FontWeight="SemiBold"
                                           MaxWidth="480"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding CurrentDevice.Audio.FileName}"
                                           IsVisible="{Binding CurrentDevice.Audio.HasFile}" />
                                <TextBlock Text="{DynamicResource InputMonitorPage.Audio.NoFile}"
                                           IsVisible="{Binding !CurrentDevice.Audio.HasFile}" />
                                <TextBlock Text="{DynamicResource InputMonitorPage.Audio.File}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Click="OnOpenAudioClick"
                                    Classes="accent"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:FluentIcon Icon="FolderOpen"
                                                   IconVariant="Regular"
                                                   IconSize="Size16" />
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Audio.Open}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </cards:CustomCard>

                    <!-- Transport: seek slider, clocks, and play/stop controls -->
                    <cards:CustomCard>
                        <StackPanel Spacing="8">
                            <Slider Minimum="0"
                                    Maximum="{Binding CurrentDevice.Audio.DurationSeconds}"
                                    Value="{Binding CurrentDevice.Audio.PositionSeconds, Mode=TwoWay}"
                                    IsEnabled="{Binding CurrentDevice.Audio.HasFile}"
                                    UseLayoutRounding="False" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding CurrentDevice.Audio.PositionText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentDevice.Audio.DurationText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                <Button Classes="audio-transport accent"
                                        Command="{Binding CurrentDevice.Audio.TogglePlayPauseCommand}">
                                    <Grid>
                                        <ic:FluentIcon Icon="Play"
                                                       IconVariant="Regular"
                                                       IconSize="Size20"
                                                       IsVisible="{Binding !CurrentDevice.Audio.IsPlaying}" />
                                        <ic:FluentIcon Icon="Pause"
                                                       IconVariant="Regular"
                                                       IconSize="Size20"
                                                       IsVisible="{Binding CurrentDevice.Audio.IsPlaying}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </cards:CustomCard>

                    <!-- Output destinations -->
                    <TextBlock Text="{DynamicResource InputMonitorPage.Audio.Output.Title}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <cards:ToggleSwitchCard Title="{DynamicResource InputMonitorPage.Audio.Output.Desktop}"
                                            IsChecked="{Binding CurrentDevice.Audio.PlayToDesktop, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,16,*"
                          RowDefinitions="Auto,8,Auto">
                        <cards:ComboBoxCard Grid.Row="0"
                                            Grid.Column="0"
                                            Title="{DynamicResource InputMonitorPage.Audio.Output.DualSense}"
                                            Tooltip="{DynamicResource InputMonitorPage.Audio.Output.DualSense.Description}"
                                            IsEnabled="{Binding CurrentDevice.Audio.CanUseControllerOutputs}"
                                            ItemsSource="{Binding CurrentDevice.Audio.ControllerOutputOptions}"
                                            SelectedIndex="{Binding CurrentDevice.Audio.ControllerOutputIndex, Mode=TwoWay}" />
                        <cards:ToggleSwitchCard Grid.Row="0"
                                                Grid.Column="2"
                                                Title="{DynamicResource InputMonitorPage.Audio.Output.Haptics}"
                                                IsEnabled="{Binding CurrentDevice.Audio.CanUseControllerOutputs}"
                                                IsChecked="{Binding CurrentDevice.Audio.PlayToHaptics, Mode=TwoWay}" />
                        <cards:CustomCard Grid.Row="2" Grid.Column="0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Audio.OutputVolume}"
                                           FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Grid.Column="0"
                                            Minimum="0"
                                            Maximum="255"
                                            TickFrequency="1"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding CurrentDevice.Audio.CanUseControllerOutputs}"
                                            UseLayoutRounding="False"
                                            Value="{Binding CurrentDevice.Audio.SpeakerVolume, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding CurrentDevice.Audio.SpeakerVolume, StringFormat={}{0:0}}" />
                                </Grid>
                            </StackPanel>
                        </cards:CustomCard>
                        <cards:CustomCard Grid.Row="2" Grid.Column="2">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Audio.HapticStrength}"
                                           FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Grid.Column="0"
                                            Minimum="0"
                                            Maximum="200"
                                            TickFrequency="1"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding CurrentDevice.Audio.CanUseControllerOutputs}"
                                            UseLayoutRounding="False"
                                            Value="{Binding CurrentDevice.Audio.HapticStrength, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding CurrentDevice.Audio.HapticStrength, StringFormat={}{0:0}}" />
                                </Grid>
                            </StackPanel>
                        </cards:CustomCard>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>