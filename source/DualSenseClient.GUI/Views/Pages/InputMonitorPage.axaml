<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualSenseClient.GUI.ViewModels.Pages"
             xmlns:controls="using:DualSenseClient.GUI.Controls"
             xmlns:cards="clr-namespace:DualSenseClient.GUI.Controls.Cards"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DualSenseClient.GUI.Views.Pages.InputMonitorPage"
             x:DataType="vm:InputMonitorPageViewModel">
    <Design.DataContext>
        <vm:InputMonitorPageViewModel />
    </Design.DataContext>
    <UserControl.Styles>
        <!-- Button pill: released -->
        <Style Selector="Border.button-pill">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <!-- Button pill: pressed -->
        <Style Selector="Border.button-pill.pressed">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.button-pill.pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
        </Style>
        <!-- Button pill icons use the primary text color when released -->
        <Style Selector="Border.button-pill ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Button pill icons: white and filled when pressed -->
        <Style Selector="Border.button-pill.pressed ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
            <Setter Property="IconVariant" Value="Filled" />
        </Style>
        <!-- Touchpad surface: released -->
        <Style Selector="Border.touchpad-surface">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <!-- Touchpad surface: pressed (glows with the accent color) -->
        <Style Selector="Border.touchpad-surface.pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <!-- Button pad: compact D-pad / face button pill -->
        <Style Selector="Border.button-pill.pad">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextElement.FontSize" Value="11" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24">
            <!-- Empty state shown when no controller is selected -->
            <cards:EmptyStateCard Title="{DynamicResource InputMonitorPage.NoDevice.Title}"
                                  Description="{DynamicResource InputMonitorPage.NoDevice.Description}"
                                  IsVisible="{Binding !HasDevice}" />

            <!-- Live status strip -->
            <cards:CustomCard IsVisible="{Binding HasDevice}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Padding="8"
                                CornerRadius="6"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                            <ic:FluentIcon Icon="XboxController"
                                           IconVariant="Regular"
                                           Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding CurrentDevice.DisplayName}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentDevice.ConnectionType}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource InputMonitorPage.Status.Report}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentDevice.SequenceNumber}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <!-- Live badge; pulses while reports are flowing -->
                        <Border CornerRadius="999"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                IsVisible="{Binding CurrentDevice.HasReport}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{DynamicResource TextOnAccentFillColorSelectedTextBrush}"
                                         VerticalAlignment="Center">
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.5"
                                                           IterationCount="Infinite">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="50%">
                                                        <Setter Property="Opacity" Value="0.25" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource InputMonitorPage.Status.Live}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource InputMonitorPage.Status.Waiting}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !CurrentDevice.HasReport}" />
                    </StackPanel>
                </Grid>
            </cards:CustomCard>

            <!-- Controller: buttons, sticks, triggers, and touchpad laid out like a DualSense -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource InputMonitorPage.Controller.Title}"
                                      Description="{DynamicResource InputMonitorPage.Controller.Description}"
                                      Icon="{x:Static fic:Symbol.Joystick}"
                                      MinHeight="64" />
                </Expander.Header>
                <cards:CustomCard>
                    <StackPanel Spacing="16">
                        <!-- Triggers, shoulders, and touchpad -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Left: L2 trigger and L1 shoulder -->
                            <Grid ColumnDefinitions="Auto,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  VerticalAlignment="Center">
                                <ProgressBar Orientation="Vertical"
                                             Width="26"
                                             Height="110"
                                             Minimum="0"
                                             Maximum="255"
                                             Value="{Binding CurrentDevice.L2}"
                                             Grid.Row="0"
                                             Grid.Column="0"
                                             HorizontalAlignment="Center" />
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.L2Click}"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Button.L2}" />
                                </Border>
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.L1}"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Button.L1}" />
                                </Border>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{Binding CurrentDevice.L2}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Grid>

                            <!-- Center: touchpad between the trigger groups, with Create/Options beside it -->
                            <StackPanel Grid.Column="1"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            HorizontalAlignment="Center">
                                    <!-- Create: left of the touchpad surface -->
                                    <Border Classes="button-pill"
                                            Classes.pressed="{Binding CurrentDevice.Create}"
                                            ToolTip.Tip="{DynamicResource InputMonitorPage.Button.Create}"
                                            VerticalAlignment="Top"
                                            Padding="5,6">
                                        <ic:FluentIcon Icon="WeatherSunnyLow"
                                                       IconVariant="Regular"
                                                       IconSize="Size20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                    <Border Classes="touchpad-surface"
                                            Classes.pressed="{Binding CurrentDevice.TouchPad}"
                                            ToolTip.Tip="{DynamicResource InputMonitorPage.Button.TouchPad}"
                                            Width="320"
                                            Height="180"
                                            CornerRadius="10"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                                            BorderThickness="2">
                                        <Grid Width="320" Height="180">
                                            <!-- Touch point 1: dot with a following label -->
                                            <Grid x:Name="Touch1DotGroup"
                                                  Width="64"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top">
                                                <StackPanel HorizontalAlignment="Center"
                                                            Spacing="3">
                                                    <Ellipse Width="16"
                                                             Height="16"
                                                             Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Border CornerRadius="8"
                                                            Padding="6,2"
                                                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{DynamicResource InputMonitorPage.Touchpad.Touch1}"
                                                                   FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Touch point 2: dot with a following label -->
                                            <Grid x:Name="Touch2DotGroup"
                                                  Width="64"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top">
                                                <StackPanel HorizontalAlignment="Center"
                                                            Spacing="3">
                                                    <Ellipse Width="16"
                                                             Height="16"
                                                             Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                             Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                                             StrokeThickness="2" />
                                                    <Border CornerRadius="8"
                                                            Padding="6,2"
                                                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{DynamicResource InputMonitorPage.Touchpad.Touch2}"
                                                                   FontSize="10" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <!-- Options: right of the touchpad surface -->
                                    <Border Classes="button-pill"
                                            Classes.pressed="{Binding CurrentDevice.Options}"
                                            ToolTip.Tip="{DynamicResource InputMonitorPage.Button.Options}"
                                            VerticalAlignment="Top"
                                            Padding="5,6">
                                        <ic:FluentIcon Icon="LineHorizontal3"
                                                       IconVariant="Regular"
                                                       IconSize="Size20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Width="320">
                                    <cards:CustomCard>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{DynamicResource InputMonitorPage.Touchpad.Touch1}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentDevice.Touch1State}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentDevice.Touch1Position}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </cards:CustomCard>
                                    <cards:CustomCard Grid.Column="1">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{DynamicResource InputMonitorPage.Touchpad.Touch2}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentDevice.Touch2State}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrentDevice.Touch2Position}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </cards:CustomCard>
                                </Grid>
                            </StackPanel>

                            <!-- Right: R1 shoulder and R2 trigger -->
                            <Grid Grid.Column="2"
                                  ColumnDefinitions="Auto,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                                <ProgressBar Orientation="Vertical"
                                             Width="26"
                                             Height="110"
                                             Minimum="0"
                                             Maximum="255"
                                             Value="{Binding CurrentDevice.R2}"
                                             Grid.Row="0"
                                             Grid.Column="1"
                                             HorizontalAlignment="Center" />
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.R1}"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,16,0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Button.R1}" />
                                </Border>
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.R2Click}"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Button.R2}" />
                                </Border>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding CurrentDevice.R2}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- D-pad, sticks, and face buttons arranged like the controller -->
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                            <!-- Row 0: D-pad, center, and face buttons -->
                            <!-- Left side: D-pad -->
                            <Grid Grid.Row="0"
                                  Grid.Column="0"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  RowDefinitions="Auto,Auto,Auto">
                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.DPadUp}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.DPadUp}">
                                    <ic:FluentIcon Icon="ChevronUp"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.DPadLeft}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.DPadLeft}">
                                    <ic:FluentIcon Icon="ChevronLeft"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.DPadRight}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.DPadRight}">
                                    <ic:FluentIcon Icon="ChevronRight"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.DPadDown}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.DPadDown}">
                                    <ic:FluentIcon Icon="ChevronDown"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Right side: face buttons -->
                            <Grid Grid.Row="0"
                                  Grid.Column="2"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  RowDefinitions="Auto,Auto,Auto">
                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.Triangle}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.Triangle}">
                                    <ic:FluentIcon Icon="TriangleUp"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="0"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.Square}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.Square}">
                                    <ic:FluentIcon Icon="Square"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="2"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.Circle}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.Circle}">
                                    <ic:FluentIcon Icon="Circle"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Classes="button-pill pad"
                                        Classes.pressed="{Binding CurrentDevice.Cross}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.Cross}">
                                    <ic:FluentIcon Icon="Dismiss"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Row 1: sticks, each centered over two columns
                                 (left over columns 0-1, right over columns 1-2) -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,16,24,0"
                                        Spacing="8"
                                        HorizontalAlignment="Center">
                                <Border Width="120"
                                        Height="120"
                                        CornerRadius="60"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="2">
                                    <Grid Width="120" Height="120">
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Center"
                                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Rectangle Width="2"
                                                   HorizontalAlignment="Center"
                                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Ellipse x:Name="LeftStickDot"
                                                 Width="12"
                                                 Height="12"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="6">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.X}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentDevice.LeftStickX}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="·"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.Y}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentDevice.LeftStickY}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.L3}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Button.L3}" />
                                </Border>
                            </StackPanel>

                            <!-- PS and Mute centered between the sticks -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,5">
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.PS}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.PS}"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Padding="0">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Button.PS}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.Mute}"
                                        ToolTip.Tip="{DynamicResource InputMonitorPage.Button.Mute}"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Padding="0">
                                    <ic:FluentIcon Icon="MicOff"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="24,16,0,0"
                                        Spacing="8"
                                        HorizontalAlignment="Center">
                                <Border Width="120"
                                        Height="120"
                                        CornerRadius="60"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="2">
                                    <Grid Width="120" Height="120">
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Center"
                                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Rectangle Width="2"
                                                   HorizontalAlignment="Center"
                                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Ellipse x:Name="RightStickDot"
                                                 Width="12"
                                                 Height="12"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="6">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.X}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentDevice.RightStickX}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="·"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Sticks.Y}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentDevice.RightStickY}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Classes="button-pill"
                                        Classes.pressed="{Binding CurrentDevice.R3}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{DynamicResource InputMonitorPage.Button.R3}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Edge function and back paddle buttons (DualSense Edge only) -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding CurrentDevice.IsEdge}">
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.FnL}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.FnL}" />
                            </Border>
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.L4}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.L4}" />
                            </Border>
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.R4}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.R4}" />
                            </Border>
                            <Border Classes="button-pill"
                                    Classes.pressed="{Binding CurrentDevice.FnR}">
                                <TextBlock Text="{DynamicResource InputMonitorPage.Button.FnR}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </cards:CustomCard>
            </Expander>

            <!-- Motion -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource InputMonitorPage.Motion.Title}"
                                      Description="{DynamicResource InputMonitorPage.Motion.Description}"
                                      Icon="{x:Static fic:Symbol.Gauge}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.GyroX}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.GyroX}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.GyroY}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.GyroY}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.GyroZ}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.GyroZ}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <cards:CardHeader Title="{DynamicResource InputMonitorPage.Motion.GyroGraph.Title}"
                                              Icon="{x:Static fic:Symbol.Gauge}"
                                              MinHeight="56" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <cards:CustomCard>
                                <controls:MotionGraph x:Name="GyroGraph"
                                                      Height="120"
                                                      Axis="Gyro"
                                                      SeriesXBrush="{DynamicResource MotionGraphXBrush}"
                                                      SeriesYBrush="{DynamicResource MotionGraphYBrush}"
                                                      SeriesZBrush="{DynamicResource MotionGraphZBrush}" />
                            </cards:CustomCard>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="16"
                                        HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphXBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="X"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphYBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Y"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphZBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Z"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.AccelX}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.AccelX}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.AccelY}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.AccelY}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <cards:CustomCard>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource InputMonitorPage.Motion.AccelZ}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentDevice.AccelZ}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </cards:CustomCard>
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <cards:CardHeader Title="{DynamicResource InputMonitorPage.Motion.AccelGraph.Title}"
                                              Icon="{x:Static fic:Symbol.Gauge}"
                                              MinHeight="56" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <cards:CustomCard>
                                <controls:MotionGraph x:Name="AccelGraph"
                                                      Height="120"
                                                      Axis="Accel"
                                                      SeriesXBrush="{DynamicResource MotionGraphXBrush}"
                                                      SeriesYBrush="{DynamicResource MotionGraphYBrush}"
                                                      SeriesZBrush="{DynamicResource MotionGraphZBrush}" />
                            </cards:CustomCard>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="16"
                                        HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphXBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="X"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphYBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Y"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="3"
                                            Background="{DynamicResource MotionGraphZBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="Z"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Output Test: vibration and adaptive trigger testing -->
            <Expander IsVisible="{Binding HasDevice}"
                      IsExpanded="True">
                <Expander.Header>
                    <cards:CardHeader Title="{DynamicResource InputMonitorPage.OutputTest.Title}"
                                      Description="{DynamicResource InputMonitorPage.OutputTest.Description}"
                                      Icon="{x:Static fic:Symbol.Pulse}"
                                      MinHeight="64" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Vibration.Title}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Vibration.Left}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ToggleSwitchCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Enable}"
                                                    IsChecked="{Binding CurrentDevice.LeftMotorEnabled, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Strength}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsEnabled="{Binding CurrentDevice.LeftMotorEnabled}"
                                              Value="{Binding CurrentDevice.LeftMotorStrength, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Vibration.Right}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ToggleSwitchCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Enable}"
                                                    IsChecked="{Binding CurrentDevice.RightMotorEnabled, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Vibration.Strength}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsEnabled="{Binding CurrentDevice.RightMotorEnabled}"
                                              Value="{Binding CurrentDevice.RightMotorStrength, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Triggers.Title}"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0" />
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Triggers.Left}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ComboBoxCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Mode}"
                                                ItemsSource="{Binding CurrentDevice.TriggerEffectModes}"
                                                SelectedIndex="{Binding CurrentDevice.LeftTriggerModeIndex, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Start}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerStartVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerStart, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.End}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerEndVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerEnd, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Force}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerForceVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerForce, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Frequency}"
                                              Minimum="0"
                                              Maximum="15"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.LeftTriggerFrequencyVisible}"
                                              Value="{Binding CurrentDevice.LeftTriggerFrequency, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="8">
                            <TextBlock Text="{DynamicResource InputMonitorPage.OutputTest.Triggers.Right}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <cards:ComboBoxCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Mode}"
                                                ItemsSource="{Binding CurrentDevice.TriggerEffectModes}"
                                                SelectedIndex="{Binding CurrentDevice.RightTriggerModeIndex, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Start}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerStartVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerStart, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.End}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerEndVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerEnd, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Force}"
                                              Minimum="0"
                                              Maximum="255"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerForceVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerForce, Mode=TwoWay}" />
                            <cards:SliderCard Title="{DynamicResource InputMonitorPage.OutputTest.Triggers.Frequency}"
                                              Minimum="0"
                                              Maximum="15"
                                              TickFrequency="1"
                                              IsVisible="{Binding CurrentDevice.RightTriggerFrequencyVisible}"
                                              Value="{Binding CurrentDevice.RightTriggerFrequency, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>