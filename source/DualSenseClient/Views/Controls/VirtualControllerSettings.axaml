<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:vm="clr-namespace:DualSenseClient.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DualSenseClient.Views.Controls.VirtualControllerSettings"
             x:DataType="vm:VirtualControllerSettingsViewModel">

    <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
            CornerRadius="8"
            Padding="20">
        <StackPanel Spacing="16">
            <!-- Header -->
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                    <ic:SymbolIcon Symbol="XboxController"
                                   FontSize="24"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Virtual Controller (Windows only)"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Emulate Xbox 360 or DualShock 4 controllers for compatibility with games and applications"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,8,0,0" />
            </StackPanel>

            <!-- Main Settings Grid -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">

                <!-- Left Column: Basic Settings -->
                <StackPanel Grid.Column="0" Spacing="16">

                    <!-- Virtual Controller Card -->
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto,*">
                                <ic:SymbolIcon Symbol="Settings"
                                               FontSize="18"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Controller Settings"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Grid.Column="1" />
                            </Grid>

                            <!-- Enable Virtual Controller -->
                            <StackPanel Spacing="6">
                                <ToggleSwitch IsChecked="{Binding EnableEmulation}"
                                              Content="Enable Virtual Controller Emulation"
                                              FontWeight="Medium"
                                              FontSize="13"
                                              VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Options -->
                            <StackPanel Spacing="6">
                                <ToggleSwitch Content="Force Stop Rumble"
                                              IsChecked="{Binding ForceStopRumble}"
                                              IsEnabled="{Binding EnableEmulation}"
                                              Margin="0,4,0,0" />
                                <ToggleSwitch Content="Ignore DS4 Lightbar Change"
                                              IsChecked="{Binding IgnoreDS4Lightbar}"
                                              IsEnabled="{Binding EnableEmulation}"
                                              Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Emulation Type -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Emulation Type"
                                           FontWeight="Medium"
                                           FontSize="13" />
                                <ComboBox SelectedIndex="{Binding EmulationTypeIndex}"
                                          IsEnabled="{Binding EnableEmulation}">
                                    <ComboBoxItem Content="Xbox 360" />
                                    <ComboBoxItem Content="DualShock 4" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Apply Button -->
                            <Button Content="Apply Virtual Controller Settings"
                                    Command="{Binding ApplyVirtualControllerSettingsCommand}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorInverseBrush}"
                                    MaxWidth="230"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorBrush}" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Advanced Settings -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!-- Trigger Thresholds Card -->
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto,*">
                                <ic:SymbolIcon Symbol="Settings"
                                               FontSize="18"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Trigger Thresholds"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Grid.Column="1" />
                            </Grid>

                            <Grid RowDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Row="0" Spacing="6">
                                    <TextBlock Text="Left Trigger Threshold"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <Slider Minimum="0" Maximum="255"
                                            Value="{Binding LeftTriggerThreshold}"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding EnableEmulation}" />
                                    <TextBlock Text="{Binding LeftTriggerThreshold}"
                                               HorizontalAlignment="Center"
                                               FontFamily="Cascadia Code,Consolas,monospace"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock Text="Right Trigger Threshold"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <Slider Minimum="0" Maximum="255"
                                            Value="{Binding RightTriggerThreshold}"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding EnableEmulation}" />
                                    <TextBlock Text="{Binding RightTriggerThreshold}"
                                               HorizontalAlignment="Center"
                                               FontFamily="Cascadia Code,Consolas,monospace"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>