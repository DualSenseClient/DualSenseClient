<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:vm="clr-namespace:DualSenseClient.ViewModels.Controls"
             xmlns:converters="clr-namespace:DualSenseClient.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="DualSenseClient.Views.Controls.SpecialActions"
             x:DataType="vm:SpecialActionsViewModel">
    <Design.DataContext>
        <vm:SpecialActionsViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <converters:ObjectToBooleanConverter x:Key="ObjectToBooleanConverter" />
        <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
            CornerRadius="8"
            Padding="20">
        <ScrollViewer>
            <StackPanel Spacing="16">
                <!-- Header -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <ic:SymbolIcon Symbol="FlashSettings"
                                       FontSize="24"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Special Actions"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Create custom button combinations to trigger special controller actions"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Margin="0,8,0,0" />
                </StackPanel>

                <!-- Main Content Grid -->
                <Grid ColumnDefinitions="2*,3*" ColumnSpacing="24">

                    <!-- Left Column: Configuration -->
                    <StackPanel Grid.Column="0" Spacing="16">

                        <!-- Action Configuration Card -->
                        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ic:SymbolIcon Symbol="Settings"
                                                   FontSize="18"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Action Configuration"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Define when the action triggers and what it does"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Name Input -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Action Name"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <TextBox Watermark="e.g., Battery Check"
                                             Text="{Binding NewSpecialActionName}" />
                                </StackPanel>

                                <!-- Input Configuration -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Input Type"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <ComboBox ItemsSource="{Binding ActionTypes}"
                                              SelectedItem="{Binding SelectedActionType}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Swipe Direction Selection (Visible when mode is swipe) -->
                                <StackPanel Spacing="6"
                                            IsVisible="{Binding IsSwipeAction, Mode=OneWay}">
                                    <TextBlock Text="Swipe Direction"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <ComboBox ItemsSource="{Binding SwipeDirections}"
                                              SelectedItem="{Binding SelectedSwipeDirection}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <Border Height="1"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Margin="0,10,0,10" />

                                <!-- Action Configuration -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Action"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <ComboBox ItemsSource="{Binding SpecialActionTypes}"
                                              SelectedItem="{Binding SelectedSpecialActionType}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Battery Indicator Type -->
                                <StackPanel Spacing="6"
                                            IsVisible="{Binding SelectedSpecialActionType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BatteryIndicator, Mode=OneWay}">
                                    <TextBlock Text="Indicator Type"
                                               FontWeight="Medium"
                                               FontSize="13" />
                                    <ComboBox ItemsSource="{Binding BatteryIndicatorTypes}"
                                              SelectedItem="{Binding SelectedBatteryIndicatorType}"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding SelectedSpecialActionType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BatteryIndicator, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Button Selection Card (Only visible when action type is not swipe) -->
                        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="20"
                                IsVisible="{Binding IsSwipeAction, Converter={StaticResource InvertedBooleanConverter}, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="Button Combination"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Clear All"
                                            Command="{Binding ClearSelectedButtonsCommand}"
                                            FontSize="12"
                                            Padding="12,6"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding SelectedButtons.Count}" />
                                </Grid>

                                <!-- Selected Buttons -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Selected Buttons"
                                               FontWeight="Medium"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}"
                                            CornerRadius="6"
                                            Padding="12"
                                            MinHeight="60"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <ScrollViewer MaxHeight="120">
                                            <ItemsControl ItemsSource="{Binding SelectedButtons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SystemAccentColorBrush}"
                                                                CornerRadius="6"
                                                                Padding="10,6"
                                                                Margin="0,0,6,6">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding .}"
                                                                           FontWeight="Medium"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource TextFillColorInverseBrush}" />
                                                                <Button Command="{Binding $parent[UserControl].DataContext.RemoveButtonCommand}"
                                                                        CommandParameter="{Binding .}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="2"
                                                                        VerticalAlignment="Center">
                                                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedButtons.Count, StringFormat='{}{0} button(s) selected'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="2,4,0,0" />
                                </StackPanel>

                                <!-- Available Buttons -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Available Buttons"
                                               FontWeight="Medium"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsControl ItemsSource="{Binding AvailableButtons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding .}"
                                                            Command="{Binding $parent[UserControl].DataContext.SelectButtonCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Padding="10,6"
                                                            Margin="0,0,6,6"
                                                            FontSize="13"
                                                            VerticalContentAlignment="Center"
                                                            HorizontalContentAlignment="Center">
                                                        <Button.Styles>
                                                            <Style Selector="Button">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                            </Style>
                                                            <Style Selector="Button:pointerover">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                                            </Style>
                                                        </Button.Styles>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="8">
                                <Button Content="Add New Action"
                                        Command="{Binding AddSpecialActionCommand}"
                                        HorizontalAlignment="Stretch"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorInverseBrush}"
                                        FontSize="14"
                                        Padding="16,12">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorBrush}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Content="Update"
                                            Command="{Binding UpdateSpecialActionCommand}"
                                            HorizontalAlignment="Stretch"
                                            Grid.Column="0"
                                            IsEnabled="{Binding SelectedSpecialAction, Converter={StaticResource ObjectToBooleanConverter}}"
                                            Foreground="{DynamicResource TextFillColorInverseBrush}"
                                            Padding="12,8">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="{DynamicResource SystemAccentColorBrush}" />
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    <Button Content="Delete"
                                            Command="{Binding DeleteSpecialActionCommand}"
                                            HorizontalAlignment="Stretch"
                                            Grid.Column="1"
                                            IsEnabled="{Binding SelectedSpecialAction, Converter={StaticResource ObjectToBooleanConverter}}"
                                            Foreground="{DynamicResource TextFillColorInverseBrush}"
                                            Padding="12,8">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Actions List & Preview -->
                    <StackPanel Grid.Column="1" Spacing="16">

                        <!-- Saved Actions Card -->
                        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <ic:SymbolIcon Symbol="List"
                                                   FontSize="18"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Saved Actions"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Grid.Column="1" />
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SystemAccentColorBrush}"
                                            CornerRadius="12"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SpecialActions.Count, StringFormat='{}{0}'}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorInverseBrush}" />
                                    </Border>
                                </Grid>

                                <ListBox ItemsSource="{Binding SpecialActions}"
                                         SelectedItem="{Binding SelectedSpecialAction}"
                                         SelectionMode="Single"
                                         MinHeight="300"
                                         MaxHeight="450"
                                         Background="Transparent">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    CornerRadius="6"
                                                    Padding="16"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                    <!-- Name and Action Type -->
                                                    <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   Grid.Column="0" />
                                                        <Border Grid.Column="1"
                                                                Background="{DynamicResource SystemAccentColorBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,2">
                                                            <TextBlock Text="{Binding Type}"
                                                                       FontSize="10"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextFillColorInverseBrush}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Input and Action Info -->
                                                    <StackPanel Grid.Row="1" Spacing="4">
                                                        <!-- Input details -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    IsVisible="{Binding IsSwipeAction, Mode=OneWay}">
                                                            <ic:SymbolIcon Symbol="SwipeRight"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding SwipeAction.Direction, StringFormat='Swipe {0}'}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    IsVisible="{Binding IsSwipeAction, Converter={StaticResource InvertedBooleanConverter}, Mode=OneWay}">
                                                            <ic:SymbolIcon Symbol="Keyboard"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Combination.Buttons.Count, StringFormat='{}{0} button(s)'}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>

                                                        <!-- Additional action details -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    IsVisible="{Binding Type, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BatteryIndicator}">
                                                            <TextBlock Text="{Binding Settings.BatteryIndicatorType}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Preview Card -->
                        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ic:SymbolIcon Symbol="Eye"
                                                   FontSize="18"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Preview"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Grid.Column="1" />
                                </Grid>

                                <Border Background="{DynamicResource ControlAltFillColorTertiaryBrush}"
                                        CornerRadius="6"
                                        Padding="16"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Current Action Configuration"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding NewSpecialActionName, TargetNullValue='Action Name'}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Margin="0,4,0,8" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{DynamicResource SystemAccentColorBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding SelectedActionType, TargetNullValue='Input Type'}"
                                                           FontWeight="Medium"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorInverseBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource SystemAccentColorBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    IsVisible="{Binding IsSwipeAction, Mode=OneWay}">
                                                <TextBlock Text="{Binding SelectedSwipeDirection, TargetNullValue='Direction'}"
                                                           FontWeight="Medium"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorInverseBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding SelectedButtons.Count, StringFormat='{}{0} button(s)', TargetNullValue='No buttons'}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsSwipeAction, Converter={StaticResource InvertedBooleanConverter}, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding SelectedSpecialActionType, TargetNullValue='Action Type'}"
                                                           FontWeight="Medium"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    IsVisible="{Binding SelectedSpecialActionType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BatteryIndicator, Mode=OneWay}">
                                                <TextBlock Text="{Binding SelectedBatteryIndicatorType, TargetNullValue='Indicator'}"
                                                           FontWeight="Medium"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="12"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <ic:SymbolIcon Symbol="Info"
                                                       FontSize="16"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorInverseBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorInverseBrush}">
                                            Create an action by setting the name, input type (button combination or swipe gesture), and the specific action to perform.
                                            For button combinations, select the buttons from the list below. For swipe gestures, select the direction.
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>